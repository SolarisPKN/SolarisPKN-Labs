---
// src/layouts/Layout.astro
import SEO from '@components/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import "@styles/global.css";
import ContextualHeader from '../components/Layout/ContextualHeader.astro';
import AnalyticsConsent from '../components/Layout/AnalyticsConsent.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  image?: string;
  schema?: 'person' | 'website' | 'article';
  canonical?: string;
  certificates?: any[];
  techSkills?: string[];
  coreSkills?: string[];
  navigation?: 'gateway' | 'tech' | 'gaming';
  seoType?: 'website' | 'article' | 'profile' | 'book';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description = 'SolarisPKN - Laboratorio transparente de ingeniería',
  lang = 'es',
  image = '/social.jpg',
  schema = 'website',
  canonical,
  certificates = [],
  techSkills = [],
  coreSkills = [],
  navigation = 'tech',
  seoType = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

// Cargar traducciones
const common = await import(`../locales/${lang}/common.json`);

const pathWithoutLang = Astro.url.pathname.replace(/^\/[a-z]{2}\//, '/');
const languagePath = /^\/404(?:\.html)?\/?$/.test(Astro.url.pathname) ? '/' : pathWithoutLang;

---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- SEO incluye: title, description, canonical, hreflang, Open Graph, etc. -->
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical || Astro.url.pathname}
      locale={lang === 'es' ? 'es_AR' : 'en_US'}
      schema={schema}
      type={seoType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      author="Pablo Sebastian Marchetti Orayen"
      jobTitle="IT Infrastructure Specialist"
      certificates={certificates}
      techSkills={techSkills}
      coreSkills={coreSkills}
    />

    <ClientRouter />

    <!-- FUENTES -->
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <!-- ELIMINADO: <link rel="canonical" ...> duplicado, ya lo genera SEO -->

    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/inter.woff2') format('woff2-variations');
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 400 600;
        font-display: swap;
        src: url('/fonts/jetbrains-mono.woff2') format('woff2-variations');
      }
    </style>
  </head>

  <body>
    <!-- SKIP TO CONTENT -->
    <a href="#main-content" class="skip-link">{lang==='es'?'Saltar al contenido':'Skip to content'}</a>

    <!-- One navigation surface per world. Gateway contains only account + language. -->
    <ContextualHeader lang={lang} mode={navigation} languagePath={languagePath} nav={common.nav} />

    <!-- MAIN -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Universal, accessible back-to-top control; round SVG, never the square emoji. -->
    <button
      type="button"
      id="back-to-top"
      class="back-to-top"
      aria-label={lang==='es'?'Volver arriba':'Back to top'}
      title={lang==='es'?'Volver arriba':'Back to top'}
      hidden
    >
      <svg viewBox="0 0 24 24" width="25" height="25" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5M5.8 11.2 12 5l6.2 6.2"></path>
      </svg>
    </button>

    <!-- FOOTER (opcionalmente usando siteUrl en lugar de hardcodear) -->
    <footer class="glass" style="margin-top: 4rem; text-align: center; font-size: 0.85rem;">
      <p>
        {common.footer.transparente}
        <a href="https://github.com/solarispkn/SolarisPKN-Labs" style="color: var(--border-cyan);">
          {common.footer.codigoAbierto}
        </a>
        — <span id="status">{common.footer.estado}</span>
      </p>
      <p style="margin-top: .7rem;">
        <a href={`/${lang}/privacy/`} style="color: var(--border-cyan);">
          {lang === 'es' ? 'Privacidad y analítica' : 'Privacy and analytics'}
        </a>
        <span aria-hidden="true"> · </span>
        <button type="button" data-analytics-settings
          style="background: none; border: 0; padding: .6rem; color: var(--border-cyan); text-decoration: underline; font: inherit; cursor: pointer; min-height: 44px;">
          {lang === 'es' ? 'Configurar estadísticas' : 'Analytics settings'}
        </button>
      </p>
    </footer>

    <!-- GA4 only loads after the visitor explicitly opts in. -->
    <AnalyticsConsent lang={lang} />

    <!-- ===== SCRIPTS ===== -->
    <script>
      import '@scripts/layout.js';
      import '@scripts/scroll-animations.js';
    </script>
  </body>
</html>