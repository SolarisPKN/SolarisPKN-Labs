---
import Layout from '../../layouts/Layout.astro';
import ArchitectureExplorer from '../../components/Architecture/ArchitectureExplorer.astro';
import { loadAllProjects } from '../../utils/projects.js';
import { buildArchitectureMap } from '../../utils/architecture-map.js';
import esCopy from '../../locales/es/arquitectura.json';
import enCopy from '../../locales/en/arquitectura.json';

export async function getStaticPaths() {
  return [{params:{lang:'es'}},{params:{lang:'en'}}];
}

const lang = Astro.params.lang === 'en' ? 'en' : 'es';
const words = lang === 'en' ? enCopy : esCopy;
const model = buildArchitectureMap(loadAllProjects(),lang);
---

<Layout title={words.titulo} description={words.descripcion} lang={lang}>
  <div class="architecture-dashboard">
    <header class="architecture-hero glass">
      <p class="arch-overline">SOLARISPKN / SYSTEM ARCHITECTURE</p>
      <h1>{words.titulo}</h1>
      <p class="arch-desc">{words.descripcion}</p>
      <div class="arch-stats" aria-label={words.resumen}>
        <article><strong>{model.totalProjects}</strong><span>{words.publicos}</span></article>
        <article><strong>{model.internalCount}</strong><span>{words.modulos}</span></article>
        <article><strong>{model.relationships.length}</strong><span>{words.relaciones}</span></article>
        <article><strong>3</strong><span>{words.vistas}</span></article>
      </div>
    </header>
    <ArchitectureExplorer model={model} lang={lang} words={words} />
    <section class="arch-footer glass">
      <h2>{words.auditoriaTitulo}</h2>
      <p>{words.auditoriaTexto}</p>
      <div class="arch-proof-grid">
        {model.relationships.map(edge=>(
          <article>
            <p class="arch-proof-kind">{edge.kind}</p>
            <h3>{edge.from} → {edge.to}</h3>
            <p>{edge.label}</p>
            <a href={edge.source} target="_blank" rel="noopener noreferrer">{words.verFuente} ↗</a>
          </article>
        ))}
      </div>
      <p class="arch-disclaimer">{words.aclaracion}</p>
    </section>
  </div>
</Layout>

<style>
.architecture-dashboard{max-width:1480px;margin:0 auto;padding:2rem clamp(1rem,3vw,3rem) 4rem;}
.architecture-hero{padding:clamp(1.5rem,3vw,2.8rem);border:1px solid rgba(35,228,216,.18);border-radius:22px;background:radial-gradient(ellipse at 90% 10%,rgba(114,75,244,.15),transparent 58%),radial-gradient(ellipse at 0 100%,rgba(10,207,193,.13),transparent 62%),rgba(13,18,31,.84)}
.arch-overline,.arch-proof-kind{font:600 .74rem 'JetBrains Mono',monospace;letter-spacing:.14em;color:#57ede4;}
.architecture-hero h1{font-size:clamp(2rem,4vw,3.4rem);line-height:1.13;margin:.7rem 0 1rem}
.arch-desc{max-width:820px;line-height:1.7;color:#c1cbda;}
.arch-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-top:2rem}
.arch-stats article{background:rgba(11,14,25,.57);border:1px solid rgba(180,198,220,.13);border-radius:14px;padding:1.15rem;display:flex;flex-direction:column;gap:.4rem}
.arch-stats strong{font:700 clamp(1.5rem,2.5vw,2.4rem) 'JetBrains Mono',monospace;color:#e9fff9}
.arch-stats span{font-size:.82rem;color:#c5d0de}
.arch-footer{padding:2rem;margin-top:2.1rem;border:1px solid rgba(180,198,220,.12);border-radius:20px}
.arch-footer h2{margin:0 0 .5rem;font-size:1.35rem}
.arch-footer>p{color:#c5d0de;line-height:1.6}
.arch-proof-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(225px,1fr));gap:1rem;margin:1.5rem 0}
.arch-proof-grid article{background:rgba(16,23,36,.75);border:1px solid rgba(180,198,220,.12);padding:1.15rem;border-radius:14px}
.arch-proof-grid h3{font-size:.95rem;overflow-wrap:anywhere}
.arch-proof-grid article p{font-size:.86rem;line-height:1.5;color:#b8c7d9}
.arch-proof-grid article a{font-size:.82rem;color:#65e7ed}
.arch-disclaimer{border-left:3px solid #edb258;padding:.5rem 1rem;background:rgba(237,178,88,.06);font-size:.9rem}
@media(max-width:720px){.arch-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.architecture-dashboard{padding:1rem .8rem 3rem}.arch-footer{padding:1rem}}
</style>
