---
// src/pages/[lang]/projects/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';
import DOMPurify from 'isomorphic-dompurify';

export async function getStaticPaths() {
  const root = process.cwd();
  const projectsBaseDir = path.join(root, 'src', 'content', 'projects');
  const slugs = [];
  if (fs.existsSync(projectsBaseDir)) {
    const items = fs.readdirSync(projectsBaseDir).filter(f => {
      const stat = fs.statSync(path.join(projectsBaseDir, f));
      return stat.isDirectory();
    });
    for (const slug of items) {
      slugs.push({ params: { lang: 'es', slug } });
      slugs.push({ params: { lang: 'en', slug } });
    }
  }
  return slugs;
}

// ==========================================
// Obtener la raíz del proyecto
// ==========================================
const root = process.cwd();
const { lang, slug } = Astro.params;

// ==========================================
// Construir rutas de archivos
// ==========================================
const projectDir = path.join(root, 'src', 'content', 'projects', slug);
const metaPath = path.join(projectDir, 'project.json');
const mdxFile = `index-${lang}.mdx`;
const mdxPath = path.join(projectDir, mdxFile);

if (!fs.existsSync(metaPath) || !fs.existsSync(mdxPath)) {
  return Astro.redirect(`/${lang}/404`);
}

// ==========================================
// Leer metadatos
// ==========================================
const meta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));
const t = await import(`../../../locales/${lang}/projects.json`);

// ==========================================
// Renderizar contenido MDX
// ==========================================
const contentRaw = fs.readFileSync(mdxPath, 'utf-8');
const htmlContent = DOMPurify.sanitize(marked.parse(contentRaw));

// ==========================================
// Datos de API (opcional)
// ==========================================
let liveMetrics = null;
if (meta.apiEndpoint) {
  try {
    const response = await fetch(meta.apiEndpoint);
    if (response.ok) {
      liveMetrics = await response.json();
    }
  } catch (error) {
    console.error('Error fetching live metrics:', error);
  }
}
---

<Layout title={meta.name?.[lang] || slug} lang={lang}>
  <main class="project-detail">
    <div class="back-link">
      <a href={`/${lang}/projects`}>{t.buttons.back}</a>
    </div>

    <header class="detail-header">
      <div class="status-row">
        <span class="status-badge" style={`--dot-color: ${meta.status === 'operational' || meta.status === 'online' ? '#22c55e' : meta.status === 'tracking' ? '#eab308' : meta.status === 'development' ? '#3b82f6' : '#f97316'}`}>
          <span class="dot"></span>
          {t.status[meta.status] || meta.status}
        </span>
        <span class="project-type">{meta.type.toUpperCase()}</span>
      </div>
      <h1>{meta.name?.[lang] || slug}</h1>
      <p class="description">{meta.description?.[lang] || meta.shortDescription?.[lang] || ''}</p>
    </header>

    <!-- Métricas (estáticas o desde API) -->
    <section class="detail-metrics">
      {(liveMetrics?.metrics || meta.metrics || []).map((metric) => (
        <div class="metric-card">
          <span class="metric-icon">{metric.icon}</span>
          <span class="metric-value">{metric.value}</span>
          <span class="metric-label">{t.metrics[metric.label.toLowerCase()] || metric.label}</span>
        </div>
      ))}
    </section>

    <!-- Contenido MDX -->
    <section class="detail-body">
      <div class="markdown-content">
        <h2>{t.tabs.overview}</h2>
        <div set:html={htmlContent} />
      </div>

      <!-- Tecnologías -->
      <div class="tech-tags">
        {meta.technologies?.map(tag => <span class="tag">{tag}</span>)}
      </div>

      <!-- Detalles adicionales -->
      {meta.details && (
        <ul class="features">
          <li><strong>Architecture:</strong> {meta.details.architecture}</li>
          <li><strong>Features:</strong> {meta.details.features?.join(', ')}</li>
          <li><strong>Uptime:</strong> {meta.details.uptime}</li>
          <li><strong>Last updated:</strong> {meta.details.lastUpdated}</li>
        </ul>
      )}

      <!-- Enlaces -->
      <div class="action-links">
        {meta.links?.github && <a href={meta.links.github} class="btn">{t.buttons.github}</a>}
        {meta.links?.docs && <a href={meta.links.docs} class="btn">{t.buttons.documentation}</a>}
        {meta.links?.live && <a href={meta.links.live} class="btn primary">{t.buttons.live}</a>}
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .project-detail {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .back-link a {
    color: #888;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
  }
  .back-link a:hover {
    color: #fff;
  }
  .detail-header {
    margin: 2rem 0 2.5rem;
  }
  .status-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #ccc;
  }
  .status-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot-color);
    display: inline-block;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.9); }
  }
  .project-type {
    font-size: 0.7rem;
    color: #888;
    background: rgba(255,255,255,0.05);
    padding: 0.1rem 0.6rem;
    border-radius: 20px;
  }
  .detail-header h1 {
    font-size: 2.8rem;
    font-weight: 600;
    margin: 0.5rem 0;
    letter-spacing: -0.02em;
  }
  .description {
    font-size: 1.15rem;
    color: #bbb;
    max-width: 700px;
    line-height: 1.5;
  }
  .detail-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .metric-card {
    background: #111;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
  }
  .metric-card .metric-icon {
    font-size: 1.5rem;
    display: block;
  }
  .metric-card .metric-value {
    font-size: 1.6rem;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    color: #eee;
    display: block;
    margin: 0.2rem 0;
  }
  .metric-card .metric-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: #888;
    letter-spacing: 0.03em;
  }
  .detail-body {
    background: #111;
    border-radius: 10px;
    padding: 1.5rem;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0;
  }
  .tag {
    font-size: 0.65rem;
    background: rgba(255,255,255,0.05);
    padding: 0.1rem 0.5rem;
    border-radius: 12px;
    color: #aaa;
    border: 1px solid rgba(255,255,255,0.04);
    letter-spacing: 0.02em;
  }
  .features {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }
  .features li {
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .action-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .btn {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.5rem 1.2rem;
    border-radius: 20px;
    color: #aaa;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    transition: all 0.2s;
  }
  .btn:hover {
    border-color: rgba(255,255,255,0.3);
    color: #fff;
  }
  .btn.primary {
    background: #0ea5e9;
    border-color: #0ea5e9;
    color: #0a0a0a;
  }
  .btn.primary:hover {
    background: #38bdf8;
    border-color: #38bdf8;
  }
</style>