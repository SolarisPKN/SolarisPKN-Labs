---
// src/pages/[lang]/projects/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import ProjectExplainer from '../../../components/Projects/ProjectExplainer.astro';
import { findExplainerAstroFiles } from '../../../utils/explainers.js';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';
import DOMPurify from 'isomorphic-dompurify';

export async function getStaticPaths() {
  const root = process.cwd();
  const projectsBaseDir = path.join(root, 'src', 'content', 'projects');
  const explainerContentDir = path.join(root, 'src', 'components', 'Projects', 'explainers', 'content');
  const customAstroSlugs = Object.keys(findExplainerAstroFiles());

  const slugs = [];
  if (fs.existsSync(projectsBaseDir)) {
    const items = fs.readdirSync(projectsBaseDir).filter(f =>
      fs.statSync(path.join(projectsBaseDir, f)).isDirectory()
    );
    for (const folderSlug of items) {
      const projectId = folderSlug.toLowerCase();
      for (const lang of ['es', 'en']) {
        const hasCustom = customAstroSlugs.includes(projectId);
        const hasExplainerJson = fs.existsSync(path.join(explainerContentDir, lang, `${projectId}.json`));
        const hasMdx = fs.existsSync(path.join(projectsBaseDir, folderSlug, `index-${lang}.mdx`));
        if (hasCustom || hasExplainerJson || hasMdx) {
          slugs.push({ params: { lang, slug: folderSlug } });
        }
      }
    }
  }
  return slugs;
}

const root = process.cwd();
const projectDir = path.join(root, 'src', 'content', 'projects', Astro.params.slug);
const explainerContentDir = path.join(root, 'src', 'components', 'Projects', 'explainers', 'content');
const metaPath = path.join(projectDir, 'project.json');
const { lang, slug } = Astro.params;

if (!fs.existsSync(metaPath)) {
  return Astro.redirect(`/${lang}/404`);
}

const meta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));
const t = await import(`../../../locales/${lang}/projects.json`);

const projectName = meta.name?.[lang] || slug;
const safeTitle = String(projectName)
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');

// ID del proyecto: SIEMPRE el slug en minúsculas. El repo SolarisPKN-Stats
// guarda todo en kebab-case minúscula sin excepción — normalizar acá evita
// que un nombre de carpeta con mayúsculas rompa el fetch de stats.
const projectId = slug.toLowerCase();
const githubUrl = meta.links?.github || '';

// ==========================================
// Resolución de contenido — 4 ramas, en orden de prioridad:
// 1) .astro custom (Figma/Magic Patterns convertidos a Astro)
// 2) JSON explainer genérico (ProjectExplainer.astro)
// 3) MDX narrativo (marked + DOMPurify)
// 4) 404
// ==========================================
const customAstroMap = findExplainerAstroFiles();
const customAstroPath = customAstroMap[projectId];

let CustomExplainer = null;
let explainerData = null;
let htmlContent = '';

if (customAstroPath) {
  const explainerModules = import.meta.glob('/src/components/Projects/explainers/**/*.astro', { eager: true });
  for (const [filePath, mod] of Object.entries(explainerModules)) {
    const fileName = filePath.split('/').pop().replace(/\.astro$/, '').toLowerCase();
    if (fileName === projectId) {
      CustomExplainer = mod.default;
      break;
    }
  }
}

if (!CustomExplainer) {
  const explainerJsonPath = path.join(explainerContentDir, lang, `${projectId}.json`);
  if (fs.existsSync(explainerJsonPath)) {
    explainerData = JSON.parse(fs.readFileSync(explainerJsonPath, 'utf-8'));
  }
}

if (!CustomExplainer && !explainerData) {
  const mdxPath = path.join(projectDir, `index-${lang}.mdx`);
  if (!fs.existsSync(mdxPath)) {
    return Astro.redirect(`/${lang}/404`);
  }
  const contentRaw = fs.readFileSync(mdxPath, 'utf-8');
  htmlContent = DOMPurify.sanitize(marked.parse(contentRaw));
}
---

<style is:global>
  .project-detail {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .back-link a {
    color: #888;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
  }
  .back-link a:hover { color: #fff; }
  .detail-header { margin: 2rem 0 2.5rem; }
  .status-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #ccc;
  }
  .status-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot-color);
    display: inline-block;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.9); }
  }
  .project-type {
    font-size: 0.7rem;
    color: #888;
    background: rgba(255,255,255,0.05);
    padding: 0.1rem 0.6rem;
    border-radius: 20px;
  }
  .detail-header h1 {
    font-size: 2.8rem;
    font-weight: 600;
    margin: 0.5rem 0;
    letter-spacing: -0.02em;
  }
  .description {
    font-size: 1.15rem;
    color: #bbb;
    max-width: 700px;
    line-height: 1.5;
  }

  /* ===== MÉTRICAS ===== */
  .stats-group-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 2rem 0 0.75rem;
    font-weight: 500;
  }
  .stats-group-title:first-child { margin-top: 0; }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
  }
  .metric-card {
    background: #111;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
  }
  .metric-card .metric-icon { font-size: 1.4rem; display: block; }
  .metric-card .metric-value {
    font-size: 1.4rem;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    color: #eee;
    display: block;
    margin: 0.2rem 0;
  }
  .metric-card .metric-label {
    font-size: 0.65rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* ===== METADATA DEL REPO ===== */
  .repo-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .repo-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    color: #aaa;
    font-family: 'JetBrains Mono', monospace;
  }
  .repo-badge-warn {
    border-color: rgba(255,121,198,0.3);
    color: #FF79C6;
    background: rgba(255,121,198,0.06);
  }

  /* ===== BARRA DE LENGUAJES ===== */
  .lang-bar-wrapper { margin: 1.5rem 0; }
  .lang-bar-wrapper h4 {
    font-size: 0.8rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }
  .lang-bar {
    display: flex;
    height: 8px;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(255,255,255,0.04);
  }
  .lang-segment { height: 100%; }
  .lang-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: #aaa;
  }
  .lang-legend-item { display: inline-flex; align-items: center; gap: 0.35rem; }
  .lang-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

  /* ===== TOPICS ===== */
  .topics-wrapper { margin: 1rem 0; }
  .topics-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .topic-pill {
    font-size: 0.7rem;
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
    background: rgba(0,255,204,0.06);
    border: 1px solid rgba(0,255,204,0.15);
    color: #0ea5e9;
    font-family: 'JetBrains Mono', monospace;
  }

  /* ===== ÚLTIMO COMMIT ===== */
  .last-commit {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin: 1rem 0 1.5rem;
  }
  .commit-icon { font-size: 1.2rem; }
  .commit-info { display: flex; flex-direction: column; gap: 0.15rem; overflow: hidden; }
  .commit-info a {
    color: #eee;
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .commit-info a:hover { color: #0ea5e9; text-decoration: underline; }
  .commit-meta { font-size: 0.7rem; color: #777; font-family: 'JetBrains Mono', monospace; }

  .stats-update-time {
    text-align: center;
    font-size: 0.8rem;
    color: #666;
    margin-top: 1.5rem;
  }

  /* ===== PAGESPEED GAUGES ===== */
  .pagespeed-container { margin: 0 0 3rem; }
  .pagespeed-container h2 {
    font-family: 'JetBrains Mono', monospace;
    color: #0ea5e9;
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
  }
  .pagespeed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.25rem;
  }
  .gauge-card {
    background: #111;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 1.25rem 1rem 1rem;
    text-align: center;
  }
  .gauge-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #888;
    margin-bottom: 0.9rem;
  }
  .gauge {
    position: relative;
    width: 110px;
    height: 58px;
    margin: 0 auto;
    overflow: hidden;
  }
  .gauge::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 110px;
    height: 110px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 9px solid rgba(255,255,255,0.06);
    border-bottom-color: transparent;
    border-left-color: transparent;
    transform: rotate(-45deg);
  }
  .needle {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 3px;
    height: 50px;
    background: #FF79C6;
    transform-origin: bottom center;
    transform: rotate(-90deg);
    transition: transform 0.1s linear;
    border-radius: 2px;
  }
  .needle::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #FF79C6;
  }
  .score {
    margin-top: 0.6rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.4rem;
    font-weight: 600;
    color: #eee;
  }

  /* ===== CORE WEB VITALS ===== */
  .vitals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .vital-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.6rem 0.5rem;
    border-radius: 10px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-left: 3px solid transparent;
  }
  .vital-value {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    font-size: 1rem;
    color: #eee;
  }
  .vital-label { font-size: 0.65rem; color: #888; text-align: center; line-height: 1.2; }
  .vital-good { border-left-color: #50FA7B; }
  .vital-mid { border-left-color: #eab308; }
  .vital-poor { border-left-color: #ef4444; }

  .detail-body {
    background: #111;
    border-radius: 10px;
    padding: 1.5rem;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .tech-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0; }
  .tag {
    font-size: 0.65rem;
    background: rgba(255,255,255,0.05);
    padding: 0.1rem 0.5rem;
    border-radius: 12px;
    color: #aaa;
    border: 1px solid rgba(255,255,255,0.04);
    letter-spacing: 0.02em;
  }
  .features { list-style: none; padding: 0; margin: 1.5rem 0; }
  .features li { padding: 0.4rem 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
  .action-links { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .btn {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.5rem 1.2rem;
    border-radius: 20px;
    color: #aaa;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    transition: all 0.2s;
  }
  .btn:hover { border-color: rgba(255,255,255,0.3); color: #fff; }
  .btn.primary { background: #0ea5e9; border-color: #0ea5e9; color: #0a0a0a; }
  .btn.primary:hover { background: #38bdf8; border-color: #38bdf8; }
</style>