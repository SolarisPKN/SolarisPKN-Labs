---
// src/pages/[lang]/projects/index.astro
import { projects } from '../../../data/projects';
import ProjectCard from '../../../components/projects/ProjectCard.astro';
import Layout from '../../../layouts/Layout.astro';

// Importación estática de traducciones
import esProjects from '../../../locales/es/projects.json';
import enProjects from '../../../locales/en/projects.json';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const t = lang === 'es' ? esProjects : enProjects;
const labsUrl = import.meta.env.PUBLIC_LABS_URL || 'https://labs.solarispkn.com.ar';
---

<Layout title={`${t.title} | SolarisPKN Labs`} lang={lang}>
  <main class="projects-page">
    <header class="page-header">
      <h1>{t.title}</h1>
      <p class="subtitle">{t.subtitle}</p>
      <div class="filter-bar">
        <button class="filter-btn active">{t.filters.all}</button>
        <button class="filter-btn">{t.filters.software}</button>
        <button class="filter-btn">{t.filters.infrastructure}</button>
        <button class="filter-btn">{t.filters.network}</button>
        <button class="filter-btn">{t.filters.automation}</button>
        <button class="filter-btn">{t.filters.hardware}</button>
        <button class="filter-btn">{t.filters.game}</button>
      </div>
    </header>

    <div class="projects-grid">
      {projects.map(project => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </main>
</Layout>

<style>
  .projects-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .page-header {
    margin-bottom: 3rem;
  }
  .page-header h1 {
    font-size: 2.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .subtitle {
    color: #aaa;
    font-size: 1.1rem;
    margin-top: 0.3rem;
  }
  .filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .filter-btn {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.08);
    color: #aaa;
    padding: 0.3rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'JetBrains Mono', monospace;
  }
  .filter-btn:hover {
    border-color: rgba(255,255,255,0.2);
    color: #fff;
  }
  .filter-btn.active {
    border-color: #0ea5e9;
    color: #fff;
    background: rgba(14, 165, 233, 0.08);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>