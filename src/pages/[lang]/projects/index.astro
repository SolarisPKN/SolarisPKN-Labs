---
// src/pages/[lang]/projects/index.astro
import Layout from '../../../layouts/Layout.astro';
import LabsTriptych from '../../../components/Projects/LabsTriptych.astro';
import triptychImage from '../../../assets/projects/labs-triptych.webp';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = await import(`../../../locales/${lang}/projects.json`);
---

<Layout title={t.title} description={t.subtitle} lang={lang}>
  <section class="projects-portal">
    <header class="page-header">
      <h1>{t.title}</h1>
      <p>{t.subtitle}</p>
    </header>

    <LabsTriptych lang={lang} image={triptychImage} />
  </section>
</Layout>

<style>
  .projects-portal {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .page-header {
    max-width: 780px;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .page-header p {
    margin: 0.65rem 0 0;
    color: #aaa;
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>