---
// src/pages/[lang]/portfolio.astro
import "@styles/portfolio.css";
import "@styles/mindmap.css";

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const lang = Astro.params.lang === 'en' ? 'en' : 'es';

import Layout from '../../layouts/Layout.astro';
const t = await import(`../../locales/${lang}/portfolio.json`);
const skills = await import(`../../locales/${lang}/portfolioskills.json`);
const common = await import(`../../locales/${lang}/common.json`);
const mindmap = (await import(`../../locales/${lang}/mindmap.json`)).default;
// Logos are bundled as hashed Vite assets during the Astro build.
// If an asset is temporarily unavailable, each card retains its initials fallback.
const experienceLogoModules = import.meta.glob('../../assets/portfolio/experience/*.{webp,png,jpg,jpeg,svg,avif}', {
  eager: true,
  query: '?url',
  import: 'default'
});
const experienceLogos: Record<string, string> = Object.fromEntries(
  Object.entries(experienceLogoModules).map(([path, asset]) => [path.split('/').pop()!, String(asset)])
);

// El build conserva un orden determinista; el carrusel decide su muestra en el navegador.
const certificates = skills.certificados ?? [];
const defaultCert = certificates[0] ?? null;

const categorias: string[] = [...new Set<string>(skills.certificados.map((c) => String(c.categoria)))];
const academias: string[] = [...new Set<string>(skills.certificados.map((c) => String(c.academia)))];
---

<Layout title="Portfolio - Pablo Marchetti Orayen" lang={lang} schema="person" certificates={skills.certificados} techSkills={skills.techIcons} coreSkills={skills.coreAreas.flatMap(area => area.items)}>
  <div class="portfolio-container">

    <!-- ===== HERO ===== -->
    <section class="hero-portfolio glass" aria-labelledby="portfolio-name">
      <div class="hero-text">
        <p class="hero-kicker">{t.hero.kicker}</p>
        <h1 id="portfolio-name" class="hero-name">{t.hero.nombre}</h1>
        <p class="hero-headline">{t.hero.headline}</p>
        <p class="hero-summary">{t.hero.resumen}</p>
        <div class="aptitudes-mini" aria-label={lang === 'es' ? 'Áreas de trabajo' : 'Areas of work'}>
          {t.aptitudesMini.map((aptitud) => <span>{aptitud}</span>)}
        </div>
        <div class="hero-navigation">
          <a href="#experiencia" class="hero-cta primary">{t.hero.verExperiencia} <span aria-hidden="true">↗</span></a>
          <a href="#conocimientos" class="hero-cta secondary">{t.hero.verConocimientos} <span aria-hidden="true">↓</span></a>
        </div>
        <div class="contact-info">
          <p>📧 <a href="mailto:PabloKoutaNya@gmail.com">{t.contacto.email}</a></p>
          <p>📱 {t.contacto.whatsappTexto}<a href="https://wa.me/541170095771">{t.contacto.whatsapp}</a></p>
        </div>
        <div class="buttons-social">
          <a href="https://www.linkedin.com/in/solarispkn" target="_blank" rel="noopener noreferrer" class="btn-social">
            <img src="/images/portfolio/logos/linkedin.svg" alt="" loading="lazy" width="20" height="20" /> LinkedIn
          </a>
          <a href="https://www.github.com/SolarisPKN" target="_blank" rel="noopener noreferrer" class="btn-social">
            <img src="/images/portfolio/logos/github.svg" alt="" loading="lazy" width="20" height="20" /> GitHub
          </a>
          <a href="https://www.youtube.com/@SolarisPKN" target="_blank" rel="noopener noreferrer" class="btn-social">
            <img src="/images/portfolio/logos/youtube.svg" alt="" loading="lazy" width="20" height="20" /> YouTube
          </a>
          <a href="/cv.pdf" download class="btn-social download">
            <img src="/images/portfolio/logos/download.svg" alt="" loading="lazy" width="20" height="20" />
            {t.botones.descargarCV}
          </a>
        </div>
      </div>
      <div class="hero-image">
        <img
          src="/images/portfolio/foto-perfil.webp"
          alt={t.hero.nombre}
          class="profile-pic"
          width="200"
          height="200"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section class="about-section glass reveal" data-reveal id="sobre-mi">
      <h2>{t.about.title}</h2>
      <p class="about-intro">{t.about.intro}</p>
      <ul class="about-points">
        {t.about.points.map((point) => <li><span aria-hidden="true">✓</span> {point}</li>)}
      </ul>
      <div class="about-story">
        {t.sobreMi.parrafos.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <!-- ===== EXPERIENCIA / EXPERIENCE ===== -->
    <section id="experiencia" class="experiencia glass reveal" data-reveal aria-labelledby="experience-heading">
      <h2 id="experience-heading">{t.experiencia.titulo}</h2>
      <div class="experience-grid">
        {t.experiencia.items.map((item) => {
          const logo = item.logo ? experienceLogos[item.logo] : null;
          return (
            <article class="experience-card">
              <div class="experience-card-head">
                <div class="experience-brand" aria-hidden="true">
                  {logo && (
                    <img
                      src={logo}
                      alt=""
                      width="88"
                      height="88"
                      loading="lazy"
                      decoding="async"
                      onerror="this.hidden=true; this.parentElement.classList.add('logo-missing');"
                    />
                  )}
                  <span class:list={['experience-initials', { 'logo-fallback': Boolean(logo) }]}>{item.initials}</span>
                </div>
                <div class="experience-heading">
                  <h3>{item.titulo}</h3>
                  <p class="experience-role">{item.cargo}</p>
                  <p class="fecha">{item.fecha}</p>
                </div>
              </div>
              <p class="experience-description">{item.texto}</p>
              <ul class="experience-tags" aria-label={lang === 'es' ? 'Tecnologías y áreas' : 'Technologies and domains'}>
                {item.tecnologias.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ===== EDUCATION ===== -->
    <section id="formacion" class="formacion glass reveal" data-reveal aria-labelledby="education-heading">
      <h2 id="education-heading">{t.formacion.titulo}</h2>
      <p class="section-lead">{t.formacion.intro}</p>
      <div class="education-grid">
        {t.formacion.grupos.map((item) => (
          <article class="education-card">
            <p class="education-kind">{item.tipo}</p>
            <h3>{item.titulo}</h3>
            <p class="education-institution">{item.institucion}</p>
            <p class="education-description">{item.descripcion}</p>
            {item.temas.length > 0 && (
              <ul class="education-topics">
                {item.temas.map((topic) => <li>{topic}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
      <a class="education-cert-link" href="#certificaciones">
        <span class="education-cert-count">{skills.certificados.length}</span>
        <span>{t.formacion.certificadoTexto}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    <!-- ===== CORE AREAS ===== -->
    <section id="conocimientos" class="core-areas glass reveal" data-reveal aria-labelledby="core-heading">
      <h2 id="core-heading">{t.coreAreasTitle}</h2>
      <p class="section-lead">{t.coreAreasIntro}</p>
      <div class="core-grid">
        {skills.coreAreas.map((area) => (
          <article class="core-card">
            <div class="core-header">
              <span class="core-icon" aria-hidden="true">{area.icon}</span>
              <h3>{area.title}</h3>
            </div>
            <ul class="core-items">
              {area.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== TECH CAROUSEL ===== -->
    <section class="tech-carousel glass reveal" data-reveal>
      <h2>{t.techCarouselTitle}</h2>
      <div class="carousel-wrapper" id="techCarouselWrapper">
        <div class="carousel-track" id="techCarouselTrack">
          {skills.techIcons.map((tech) => (
            <div class="carousel-item-wrapper">
              <div class="carousel-item">
                <img 
                  src={`/images/portfolio/carruseltech/${tech}.svg`} 
                  alt={tech} 
                  class="tech-icon"
                  loading="lazy"
                  decoding="async"
                  width="40"
                  height="40"
                  onerror="this.style.display='none'; this.parentElement.classList.add('fallback');"
                />
                <span class="tech-icon-fallback">{tech}</span>
              </div>
              <span class="tech-icon-name">{tech}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== CERTIFICACIONES ===== -->
    <section id="certificaciones" class="certificaciones glass reveal" data-reveal data-certificates={JSON.stringify(certificates)}>
      <h2>{t.certificationsTitle}</h2>

      <!-- FILTROS -->
      <div class="cert-filters-horizontal">
        <input type="text" id="cert-search" class="cert-search" placeholder={t.certificationsSearch || 'Buscar...'} />
        <select id="cert-filter-categoria" class="cert-filter" aria-label="Filtrar por categoría">
          <option value="all">Todas las categorías</option>
          {categorias.map(categoria => (
            <option value={categoria}>{categoria}</option>
          ))}
        </select>
        <select id="cert-filter-subcategoria" class="cert-filter" aria-label="Filtrar por subcategoría">
          <option value="all">Todas las subcategorías</option>
        </select>
        <select id="cert-filter-academia" class="cert-filter" aria-label="Filtrar por academia">
          <option value="all">Todas las academias</option>
          {academias.map(academia => (
            <option value={academia}>{academia}</option>
          ))}
        </select>
        <button id="cert-clear-filters" class="btn-clear-filters">Limpiar filtros</button>
      </div>

      <!-- LAYOUT PRINCIPAL: dos columnas -->
      <div class="cert-main-layout">
        <!-- COLUMNA IZQUIERDA: DETALLE -->
        <div class="cert-detalle" id="certDetalle">
          <div class="cert-detalle-img">
            <img 
              id="certDetalleImagen" 
              src={defaultCert?.imagen || '/images/placeholder.webp'} 
              alt={defaultCert?.nombre || 'Certificado'} 
              width="600" 
              height="400" 
              loading="lazy"
            />
          </div>
          <div class="cert-detalle-info">
            <h3 id="certDetalleNombre">{defaultCert?.nombre || 'Selecciona un certificado'}</h3>
            <p id="certDetalleAcademia">🏛️ {defaultCert?.academia || ''}</p>
            <p id="certDetalleCategoria">📂 {defaultCert?.categoria || ''}</p>
            <p id="certDetalleSubcategoria">🏷️ {defaultCert?.subcategoria || ''}</p>
            <a id="certDetalleLink" href={defaultCert?.link || '#'} target="_blank" rel="noopener noreferrer">Ver certificado</a>
            <span id="certDetalleId">ID: {defaultCert?.id || 'No disponible'}</span>
          </div>
        </div>

        <!-- COLUMNA DERECHA: CARRUSEL VERTICAL -->
        <div class="cert-carousel-wrapper-vertical">
          <div class="cert-carousel-viewport" id="certCarouselViewport">
            <div class="cert-carousel-vertical" id="certCarouselVertical">
              {certificates.map((cert, idx) => (
                <div class="cert-thumb" 
                     data-index={idx}
                     data-nombre={cert.nombre}
                     data-categoria={cert.categoria || ''}
                     data-subcategoria={cert.subcategoria || ''}
                     data-academia={cert.academia || ''}
                     data-cert={JSON.stringify(cert)}>
                  <img 
                    src={cert.imagen || '/images/placeholder.webp'} 
                    alt={cert.nombre} 
                    loading="lazy"
                    width="50"
                    height="50"
                  />
                  <div class="thumb-info">
                    <span class="thumb-nombre">{cert.nombre}</span>
                    <span class="thumb-meta">{cert.academia || ''}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="carousel-controls-vertical">
            <button id="carousel-up-vertical" class="carousel-btn">▲</button>
            <button id="carousel-down-vertical" class="carousel-btn">▼</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== PHILOSOPHY ===== -->
    <section class="philosophy glass reveal" data-reveal>
      <blockquote class="philosophy-quote">“{t.philosophy}”</blockquote>
    </section>

    <!-- ===== INTERESES ===== -->
    <section class="intereses-hobbies glass reveal" data-reveal>
      <h2>{t.estudios.interesesTitulo}</h2>
      <ul class="intereses-lista">
        {t.estudios.intereses.map((interes) => <li>{interes}</li>)}
      </ul>
    </section>

    <!-- ===== MAPA MENTAL / KNOWLEDGE GRAPH ===== -->
    <section class="mind-map glass reveal" data-reveal aria-labelledby="mindmap-title">
      <h2 id="mindmap-title">🗺️ {mindmap.ui.title}</h2>
      <p class="mindmap-intro">{mindmap.ui.subtitle}</p>
      <div id="knowledge-map">
        <div class="mindmap-toolbar">
          <input id="mindmap-search" type="search" placeholder={mindmap.ui.search} aria-label={mindmap.ui.search} autocomplete="off" />
          <select id="mindmap-kind" aria-label={mindmap.ui.all}>
            <option value="all">{mindmap.ui.all}</option>
            <option value="work">{mindmap.ui.works}</option>
            <option value="project">{mindmap.ui.projects}</option>
            <option value="area">{mindmap.ui.areas}</option>
            <option value="skill">{mindmap.ui.skills}</option>
          </select>
          <button type="button" id="mindmap-mode">{mindmap.ui.full}</button>
          <button type="button" id="mindmap-reset">{mindmap.ui.reset}</button>
        </div>
        <div id="mindmap-results" class="mindmap-results" aria-live="polite"></div>
        <div class="mindmap-main">
          <div class="mindmap-stage">
            <svg id="mindmap-svg" role="group" aria-label={mindmap.ui.title} tabindex="0" xmlns="http://www.w3.org/2000/svg">
              <title>{mindmap.ui.title}</title>
              <desc>{mindmap.ui.subtitle}</desc>
            </svg>
            <div class="mindmap-zoom">
              <button type="button" id="mindmap-plus" aria-label={mindmap.ui.zoomIn} title={mindmap.ui.zoomIn}>＋</button>
              <button type="button" id="mindmap-minus" aria-label={mindmap.ui.zoomOut} title={mindmap.ui.zoomOut}>−</button>
              <button type="button" id="mindmap-fit" aria-label={mindmap.ui.fit} title={mindmap.ui.fit}>⤢</button>
            </div>
          </div>
          <aside id="mindmap-detail" class="mindmap-detail" aria-live="polite">
            <h3>{mindmap.ui.select}</h3>
          </aside>
        </div>
        <p id="mindmap-counter" class="mindmap-note"></p>
        <p class="mindmap-note">{mindmap.ui.hint} · {mindmap.ui.source}</p>
      </div>
      <script id="mindmap-data" type="application/json" set:html={JSON.stringify(mindmap).replace(/</g, '\\u003c')} />
    </section>

    <!-- ===== FOOTER ===== -->
    <footer class="contact-footer glass reveal" data-reveal>
      <p>📧 <a href="mailto:PabloKoutaNya@gmail.com">{t.contacto.email}</a></p>
      <p>📱 WhatsApp: <a href="https://wa.me/541170095771">{t.contacto.whatsapp}</a></p>
      <a href="/cv.pdf" download class="btn-social download">{t.botones.descargarCV}</a>
      <div class="logos-footer">
        <span>SolarisPKN</span>
      </div>
    </footer>

  </div>

  <!-- ===== SCRIPTS (modularizados) ===== -->
  <script>
    import { initTechCarousel } from '@scripts/techCarousel.js';
    import { initCertificates } from '@scripts/certificates.js';
    import { initMindMap } from '@scripts/mindmap.js';

    let cleanupPortfolio = () => {};

    function initPortfolio() {
      cleanupPortfolio();

      const section = document.querySelector<HTMLElement>('.certificaciones[data-certificates]');
      let certificates = [];

      try {
        certificates = JSON.parse(section?.dataset.certificates ?? '[]');
      } catch (error) {
        console.warn('No se pudieron leer los certificados serializados.', error);
      }

      const cleanups = [
        initTechCarousel(),
        initCertificates(certificates),
        initMindMap(),
      ].filter((cleanup) => typeof cleanup === 'function');

      cleanupPortfolio = () => {
        cleanups.forEach((cleanup) => cleanup());
        cleanupPortfolio = () => {};
      };
    }

    const portfolioWindow = window as typeof window & { __portfolioListenersAttached?: boolean };
    if (!portfolioWindow.__portfolioListenersAttached) {
      portfolioWindow.__portfolioListenersAttached = true;
      document.addEventListener('astro:page-load', initPortfolio);
      document.addEventListener('astro:before-swap', () => cleanupPortfolio());
    }
  </script>
</Layout>