---
import Layout from '../../layouts/Layout.astro';
import WorldGateway from '../../components/Home/WorldGateway.astro';
import esWords from '../../locales/es/gateway.json';
import enWords from '../../locales/en/gateway.json';

export function getStaticPaths(){
  return [{params:{lang:'es'}},{params:{lang:'en'}}];
}
const lang = Astro.params.lang === 'en' ? 'en' : 'es';
const words = lang === 'en' ? enWords : esWords;
---

<Layout title={words.pageTitle} description={words.lead} lang={lang}>
  <WorldGateway lang={lang} words={words} />
</Layout>
