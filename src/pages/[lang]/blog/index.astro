---
// src/pages/[lang]/blog/index.astro
import Layout from '../../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

// 🔥 Importar CSS específico del blog
import '../../../styles/blog.css';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const lang = Astro.params.lang === 'en' ? 'en' : 'es';

// ==========================================
// Leer todos los posts del sistema de archivos
// ==========================================
const root = process.cwd();
const blogBaseDir = path.join(root, 'src', 'content', 'blog');
const posts = [];

if (fs.existsSync(blogBaseDir)) {
  const postSlugs = fs.readdirSync(blogBaseDir).filter(f => {
    const stat = fs.statSync(path.join(blogBaseDir, f));
    return stat.isDirectory();
  });

  for (const slug of postSlugs) {
    const metaPath = path.join(blogBaseDir, slug, 'post.json');
    const localePath = path.join(root, 'src', 'locales', lang, 'posts', `${slug}.json`);

    if (fs.existsSync(metaPath) && fs.existsSync(localePath) && fs.existsSync(path.join(blogBaseDir, slug, 'index-' + lang + '.mdx'))) {
      const meta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));
      const locale = JSON.parse(fs.readFileSync(localePath, 'utf-8'));
      posts.push({
        slug,
        ...meta,
        title: locale.title || meta.title || slug,
        description: locale.description || meta.description || '',
      });
    }
  }
}

// Ordenar por fecha (más reciente primero)
posts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Tags únicos
const allTags = [...new Set(posts.flatMap(p => Array.isArray(p.tags) ? p.tags : []))].sort((a,b)=>a.localeCompare(b,lang));

// Posts recientes (sin inventar métricas de visitas)
const popularPosts = posts.slice(0, 5);

const t = await import(`../../../locales/${lang}/blog.json`);
const formatDate = date => new Intl.DateTimeFormat(lang === 'es' ? 'es-AR' : 'en-US', {day:'numeric', month:'long',year:'numeric', timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));
const formatShortDate = date => new Intl.DateTimeFormat(lang === 'es' ? 'es-AR' : 'en-US', {day:'numeric', month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));
---

<Layout title={t.titulo} description={t.descripcion} lang={lang}>
  <div class="blog-index">
    <h1 class="blog-title">
      {t.titulo}
    </h1>
    <p class="blog-intro">{t.descripcion}</p>

    {posts.length === 0 ? (
      <div class="glass" style="padding: 3rem; text-align: center;">
        <p style="opacity: 0.6;">📝 No hay posts aún. ¡Crea el primero con <code>npm run create-post</code>!</p>
      </div>
    ) : (
      <>
        <div class="blog-layout">
          <div class="blog-main">
            <!-- Filtros de tags -->
            <div class="blog-filter-bar">
              <span class="blog-filter-icon" aria-hidden="true">🏷️</span>
              <button 
                class="tag-filter active" type="button" aria-pressed="true" 
                data-tag="all"
              >
                {t.todos}
              </button>
              <details class="blog-tag-picker">
                <summary>{t.filtrarPorTags} ({allTags.length})</summary>
                <div class="blog-tag-options">
                  {allTags.map(tag => (
                <button 
                  class="tag-filter" type="button" aria-pressed="false" 
                  data-tag={tag}
                >
                  #{tag}
                </button>
                  ))}
                </div>
              </details>
            </div>

            <output class="blog-filter-status" data-blog-result-count data-results-label={t.resultados} aria-live="polite">{posts.length} {t.resultados}</output>
            <!-- Grid de posts -->
            <div id="post-grid">
              {posts.map(post => (
                <a href={'/'+lang+'/blog/'+post.slug+'/'} class="post-card-link" data-tags={post.tags?.join(',') || ''}>
                  <div class="post-card glass">
                    {post.heroImage && (
                      <div style="overflow: hidden; height: 200px; flex-shrink: 0;">
                        <img 
                          src={post.heroImage} 
                          alt={post.title} 
                          style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" 
                          loading="lazy" 
                        />
                      </div>
                    )}
                    <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
                      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                        {post.tags?.slice(0, 3).map(tag => (
                          <span style="font-size: 0.7rem; padding: 0.2rem 0.6rem; border-radius: 20px; background: rgba(0,255,204,0.1); border: 1px solid var(--border-cyan); color: var(--border-cyan);">
                            #{tag}
                          </span>
                        ))}
                        {post.tags?.length > 3 && (
                          <span style="font-size: 0.7rem; padding: 0.2rem 0.6rem; opacity: 0.6;">+{post.tags.length - 3}</span>
                        )}
                      </div>
                      <h2 class="blog-card-heading">
                        {post.title}
                      </h2>
                      {post.description && (
                        <p style="font-size: 0.9rem; opacity: 0.7; margin: 0 0 1rem 0; flex: 1;">
                          {post.description}
                        </p>
                      )}
                      <div style="font-size: 0.8rem; opacity: 0.5; margin-top: auto;">
                        {formatDate(post.date)}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Sidebar: Posts populares -->
          <aside class="blog-sidebar">
            <div class="blog-sidebar-card glass">
              <h2 class="blog-sidebar-heading">🕒 {t.recientes}</h2>
              <ul style="list-style: none; padding: 0; margin: 0;">
                {popularPosts.map(p => (
                  <li style="margin-bottom: 0.75rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <a href={'/'+lang+'/blog/'+p.slug+'/'} class="popular-post-link">
                      {p.title}
                    </a>
                    <div style="font-size: 0.7rem; opacity: 0.5; margin-top: 0.2rem;">
                      {formatShortDate(p.date)}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </>
    )}
  </div>

  <!-- ===== SCRIPT (fuera del HTML) ===== -->
  <script>
    import '../../../scripts/blog.js';
  </script>
</Layout>