---
// src/pages/[lang]/blog/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';
import DOMPurify from 'isomorphic-dompurify';

import '../../../styles/blog-post.css';

export async function getStaticPaths() {
  const root = process.cwd();
  const blogBaseDir = path.join(root, 'src', 'content', 'blog');
  const routes = [];
  if (!fs.existsSync(blogBaseDir)) return routes;

  const items = fs.readdirSync(blogBaseDir).filter((entry) =>
    fs.statSync(path.join(blogBaseDir, entry)).isDirectory()
  );

  for (const slug of items) {
    const postDir = path.join(blogBaseDir, slug);
    const metaExists = fs.existsSync(path.join(postDir, 'post.json'));
    if (!metaExists) continue;

    for (const lang of ['es', 'en']) {
      const contentExists = fs.existsSync(path.join(postDir, `index-${lang}.mdx`));
      const localeExists = fs.existsSync(path.join(root, 'src', 'locales', lang, 'posts', `${slug}.json`));
      if (contentExists && localeExists) routes.push({ params: { lang, slug } });
    }
  }
  return routes;
}

const root = process.cwd();
const { slug } = Astro.params;
const lang = Astro.params.lang === 'en' ? 'en' : 'es';
const postDir = path.join(root, 'src', 'content', 'blog', slug);
const metaPath = path.join(postDir, 'post.json');
const mdxPath = path.join(postDir, `index-${lang}.mdx`);
const localePath = path.join(root, 'src', 'locales', lang, 'posts', `${slug}.json`);

if (!fs.existsSync(metaPath) || !fs.existsSync(mdxPath) || !fs.existsSync(localePath)) {
  return Astro.redirect(`/${lang}/404`);
}

const meta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));
const locale = JSON.parse(fs.readFileSync(localePath, 'utf-8'));
const title = locale.title || meta.title || slug;
const description = locale.description || meta.description || '';
const { date, tags, category, heroImage, images } = meta;

const contentRaw = fs.readFileSync(mdxPath, 'utf-8');
const contentWithoutFrontmatter = contentRaw.replace(/^---[\s\S]*?---\s*/, '');
const rawHtml = await marked.parse(contentWithoutFrontmatter);
const htmlContent = DOMPurify.sanitize(rawHtml);

const dateStr = new Date(date + 'T00:00:00').toLocaleDateString(lang === 'es' ? 'es-AR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const t = await import(`../../../locales/${lang}/blog.json`);
---

<Layout title={title} lang={lang}>
  <article style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-family: 'JetBrains Mono', monospace; color: var(--border-cyan);">
      {title}
    </h1>
    {description && <p class="post-description">{description}</p>}
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0;">
      {tags?.map(tag => (
        <span style="font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 20px; background: rgba(0,255,204,0.1); border: 1px solid var(--border-cyan); color: var(--border-cyan);">
          #{tag}
        </span>
      ))}
    </div>
    <p style="opacity: 0.5; font-size: 0.9rem;">
      {dateStr} {category && `· ${category}`}
    </p>

    {heroImage && (
      <img src={heroImage} alt={title} style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 16px; margin: 1.5rem 0; border: 1px solid rgba(255,255,255,0.1);" />
    )}

    <div class="prose">
      <div set:html={htmlContent}></div>
    </div>

    {images?.length > 0 && (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin: 2rem 0;">
        {images.map(img => (
          <img src={img} alt={lang === 'es' ? 'Imagen del post' : 'Post image'} style="width: 100%; height: 200px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);" />
        ))}
      </div>
    )}

    <section class="glass" data-labs-comments data-post={slug} data-lang={lang}
      style="padding:1.5rem;margin-top:2rem;border:1px solid rgba(255,255,255,.14);border-radius:16px">
      <h2>{lang==='en'?'Community comments':'Comentarios de la comunidad'}</h2>
      <ul data-comment-list style="padding-left:1.3rem;line-height:1.7"></ul>
      <p data-comment-feedback role="status" style="color:#b5d6df"></p>
      <form data-comment-form hidden>
        <label for="labs-comment-body">{lang==='en'?'Your comment':'Tu comentario'}</label>
        <textarea id="labs-comment-body" required minlength="3" maxlength="1000" rows="5"
          style="display:block;width:100%;padding:.8rem;background:#101829;border:1px solid #456777;color:#fff;border-radius:9px"></textarea>
        <div data-comment-verification style="margin:1rem 0"></div>
        <button type="submit" style="border-radius:9px;padding:.7rem 1rem;background:#185457;border:1px solid #58e3d6;color:#fff">
          {lang==='en'?'Submit for review':'Enviar para revisión'}
        </button>
      </form>
      <a href={('/'+lang+'/mi-cuenta/')}>{lang==='en'?'My account':'Mi cuenta'} →</a>
    </section>
  </article>
</Layout>
<script>import '../../../scripts/community.js';</script>
