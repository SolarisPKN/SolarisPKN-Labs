---
export function getStaticPaths() { return [{params:{lang:'es'}},{params:{lang:'en'}}]; }
const lang = Astro.params.lang === 'en' ? 'en' : 'es';
const url = '/exo-auth-policy/privacy/#'+lang;
---
<!doctype html>
<html lang={lang}>
<head><meta charset="utf-8"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={`0;url=${url}`}/><link rel="canonical" href="https://labs.solarispkn.com.ar/exo-auth-policy/privacy/"/><title>EXO Research Lab · Public policy</title></head>
<body><p><a href={url}>{lang==='en'?'Continue to the public application policy':'Continuar a la información pública de la aplicación'}</a></p></body>
</html>