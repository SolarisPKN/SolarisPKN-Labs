---
const { data } = Astro.props;
---

<section class="pe-hero glass">
  <p class="pe-badge">{data.hero.badge}</p>
  <h2 class="pe-hero-title">{data.hero.tituloParte1} <span class="pe-accent">{data.hero.tituloDestacado}</span></h2>
  <p class="pe-hero-desc">{data.hero.descripcion}</p>
</section>

<section class="pe-quote glass">
  <p class="pe-eyebrow">{data.filosofia.label}</p>
  <blockquote>"{data.filosofia.quote}"</blockquote>
</section>

<section class="pe-block">
  <p class="pe-eyebrow">{data.features.label}</p>
  <h3>{data.features.titulo}</h3>
  <div class="pe-grid">
    {data.features.items.map((f) => (
      <article class="glass pe-card">
        <div class="pe-emoji">{f.emoji}</div>
        <p class="pe-eyebrow small">{f.label}</p>
        <h4>{f.titulo}</h4>
        <p>{f.texto}</p>
      </article>
    ))}
  </div>
</section>

<section class="pe-block">
  <p class="pe-eyebrow">{data.architecture.label}</p>
  <h3>{data.architecture.titulo}</h3>
  <div class="glass pe-flow">
    {data.architecture.flow.map((step, i) => (
      <Fragment>
        <div class="pe-flow-step">
          <div class="pe-flow-id">{step.id}</div>
          <div class="pe-flow-desc">{step.desc}</div>
        </div>
        {i < data.architecture.flow.length - 1 && <span class="pe-flow-arrow" aria-hidden="true">→</span>}
      </Fragment>
    ))}
  </div>
  <div class="pe-code-grid">
    <div class="glass">
      <p class="pe-eyebrow small">{data.architecture.storageTitulo}</p>
      <pre class="pe-code">{data.architecture.storageCode}</pre>
    </div>
    <div class="glass">
      <p class="pe-eyebrow small">{data.architecture.registryTitulo}</p>
      <pre class="pe-code">{data.architecture.registryCode}</pre>
    </div>
  </div>
</section>

<section class="pe-block">
  <p class="pe-eyebrow">{data.connectors.label}</p>
  <h3>{data.connectors.titulo}</h3>
  <div class="glass connectors-tabs">
    <div class="pe-tabs-row" role="tablist">
      {data.connectors.items.map((c, i) => (
        <button type="button" class:list={['pe-tab', { active: i === 0 }]} data-tab-index={i} role="tab" aria-selected={i === 0}>
          <span>{c.emoji}</span> {c.name}
        </button>
      ))}
    </div>
    {data.connectors.items.map((c, i) => (
      <div class:list={['pe-tab-panel', { active: i === 0 }]} data-panel-index={i}>
        <h4>{c.emoji} {c.name}</h4>
        <p class="pe-tab-via">{data.connectors.viaLabel} {c.api}</p>
        <p>{c.desc}</p>
        <p class="pe-eyebrow small">{data.connectors.metricsLabel}</p>
        <ul class="pe-metric-list">
          {c.metrics.map((m) => <li>▸ {m}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<section class="pe-block">
  <p class="pe-eyebrow">{data.techStack.label}</p>
  <h3>{data.techStack.titulo}</h3>
  <div class="pe-tech-grid">
    {data.techStack.items.map((t) => (
      <div class="glass pe-tech-item">
        <p class="pe-tech-name">{t.name}</p>
        <p class="pe-tech-role">{t.role}</p>
      </div>
    ))}
  </div>
</section>

<section class="pe-block">
  <p class="pe-eyebrow">{data.security.label}</p>
  <h3>{data.security.titulo}</h3>
  <div class="glass">
    {data.security.items.map((item, i) => (
      <div class="pe-security-item">
        <span class="pe-security-num">{i + 1}</span>
        <p>{item}</p>
      </div>
    ))}
  </div>
</section>

<section class="pe-block">
  <p class="pe-eyebrow">{data.roadmap.label}</p>
  <h3>{data.roadmap.titulo}</h3>
  <div class="pe-roadmap-grid">
    {data.roadmap.phases.map((phase) => (
      <div class="glass pe-phase">
        <p class="pe-eyebrow small">{phase.num}</p>
        <h4>{phase.name}</h4>
        <ul>{phase.items.map((item) => <li>— {item}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<section class="pe-cta glass">
  <h3>{data.cta.titulo}</h3>
  <p>{data.cta.descripcion}</p>
</section>

<style>
  .pe-hero, .pe-quote, .pe-cta { text-align: center; margin-bottom: 2rem; padding: 2.5rem 2rem; }
  .pe-badge { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--border-cyan); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; }
  .pe-hero-title { font-family: 'JetBrains Mono', monospace; font-size: clamp(1.5rem, 4vw, 2.2rem); }
  .pe-accent { color: var(--border-cyan); }
  .pe-hero-desc { max-width: 560px; margin: 1rem auto 0; opacity: 0.8; }
  .pe-quote blockquote { font-size: 1.15rem; font-style: italic; opacity: 0.9; }
  .pe-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--border-cyan); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; }
  .pe-eyebrow.small { font-size: 0.68rem; opacity: 0.8; }
  .pe-block { margin: 2.5rem 0; }
  .pe-block h3 { font-family: 'JetBrains Mono', monospace; font-size: 1.4rem; margin-bottom: 1.25rem; }
  .pe-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.1rem; }
  .pe-card { padding: 1.4rem; }
  .pe-emoji { font-size: 1.6rem; margin-bottom: 0.5rem; }
  .pe-card h4 { margin: 0.4rem 0 0.5rem; font-size: 0.95rem; }
  .pe-card p { font-size: 0.85rem; opacity: 0.75; line-height: 1.5; }
  .pe-flow { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem; padding: 2rem; }
  .pe-flow-step { background: rgba(0,255,204,0.08); border: 1px solid var(--border-cyan); border-radius: 12px; padding: 0.6rem 1.1rem; text-align: center; min-width: 120px; }
  .pe-flow-id { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--border-cyan); }
  .pe-flow-desc { font-size: 0.72rem; opacity: 0.6; }
  .pe-flow-arrow { color: var(--accent-pink); font-size: 1.2rem; }
  .pe-code-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 1.25rem; }
  .pe-code { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; line-height: 1.7; opacity: 0.75; overflow-x: auto; white-space: pre; }
  .connectors-tabs { padding: 0; overflow: hidden; }
  .pe-tabs-row { display: flex; border-bottom: 1px solid rgba(0,255,204,0.2); }
  .pe-tab { flex: 1; padding: 1rem; background: transparent; border: none; color: rgba(224,224,224,0.5); font-size: 0.88rem; cursor: pointer; transition: all 0.2s; }
  .pe-tab.active { background: rgba(0,255,204,0.08); color: var(--border-cyan); box-shadow: inset 0 -2px 0 var(--border-cyan); }
  .pe-tab-panel { display: none; padding: 1.75rem; }
  .pe-tab-panel.active { display: block; }
  .pe-tab-via { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; opacity: 0.5; margin-bottom: 0.75rem; }
  .pe-metric-list { list-style: none; padding: 0; margin-top: 0.5rem; }
  .pe-metric-list li { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; padding: 0.35rem 0; opacity: 0.85; }
  .pe-tech-grid { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .pe-tech-item { flex: 1; min-width: 130px; padding: 1rem; }
  .pe-tech-name { font-family: 'JetBrains Mono', monospace; color: var(--border-cyan); font-size: 0.85rem; }
  .pe-tech-role { font-size: 0.75rem; opacity: 0.6; }
  .pe-security-item { display: flex; gap: 1rem; padding: 1rem 0; border-top: 1px solid rgba(0,255,204,0.08); }
  .pe-security-item:first-child { border-top: none; }
  .pe-security-num { min-width: 26px; height: 26px; background: rgba(0,255,204,0.1); border: 1px solid var(--border-cyan); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--border-cyan); flex-shrink: 0; }
  .pe-roadmap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
  .pe-phase { padding: 1.2rem; }
  .pe-phase h4 { font-size: 0.95rem; margin: 0.3rem 0 0.75rem; }
  .pe-phase ul { list-style: none; padding: 0; font-size: 0.78rem; opacity: 0.6; }
  .pe-phase li { padding: 0.2rem 0; }
</style>