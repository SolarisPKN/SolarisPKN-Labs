---
// src/components/SEO.astro
export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile' | 'book';
  locale?: string;
  schema?: 'person' | 'organization' | 'website' | 'article' | 'breadcrumb' | 'faq';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  jobTitle?: string;
  // !!!!! AÑADIMOS ESTAS PROPS PARA RECIBIR LOS DATOS DEL PORTFOLIO !!!!!
  certificates?: any[];
  techSkills?: string[];
  coreSkills?: string[];
}

const {
  title,
  description,
  image = '/social.jpg',
  canonical,
  type = 'website',
  locale = 'es_AR',
  schema = 'website',
  publishedTime,
  modifiedTime,
  author = 'Pablo Sebastian Marchetti Orayen',
  tags = [],
  jobTitle = 'IT Infrastructure Specialist',
  // !!!!! RECIBIMOS LOS DATOS AQUÍ !!!!!
  certificates = [],
  techSkills = [],
  coreSkills = []
} = Astro.props;

// ===== OBTENER URL BASE =====
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://labs.solarispkn.com.ar';
const fullUrl = new URL(canonical ?? '/', siteUrl).toString();
const fullImage = image.startsWith('http') ? image : new URL(image, siteUrl).toString();

// ===== DETECTAR IDIOMA ACTUAL Y GENERAR HREFLANG =====
const currentPath = Astro.url.pathname;
// Detecta si la ruta empieza con /en/; por defecto asume español
const currentLang = currentPath.startsWith('/en/') ? 'en' : 'es';
// Elimina el prefijo de idioma para obtener la ruta "limpia"
const pathWithoutLang = currentPath.replace(/^\/[a-z]{2}\//, '/');

const alternateUrls = {
  es: `${siteUrl}/es${pathWithoutLang}`,
  en: `${siteUrl}/en${pathWithoutLang}`,
};

// ===== MAPEO AUTOMÁTICO DE DATOS =====

// 1. Mapeo de Credenciales (Certificaciones)
//    Toma el array de certificados y lo transforma al formato de Schema.org
const mappedCredentials = certificates.map(cert => ({
  '@type': 'EducationalOccupationalCredential',
  'name': cert.nombre,
  'url': cert.link || undefined,
  'credentialCategory': 'certification',
  'recognizedBy': cert.academia ? { '@type': 'Organization', 'name': cert.academia } : undefined,
  'image': cert.imagen || undefined,
  'description': `${cert.categoria || ''} - ${cert.subcategoria || ''}`.trim() || undefined
}));

// 2. Mapeo de Habilidades (KnowsAbout)
//    Combina las habilidades técnicas (techSkills) y las habilidades de las áreas principales (coreSkills)
const allSkills = [...new Set([...coreSkills, ...techSkills])];
const mappedKnowsAbout = allSkills.map(skill => skill);

// 3. Mapeo de Ocupaciones (HasOccupation)
//    Puedes extraerlo de tus datos o dejarlo estático como un array de strings.
//    Lo dejamos como un array estático por ahora, pero podrías mapearlo también.
const occupations = [
  'Software Developer',
  'DevOps Engineer',
  'AI Developer',
  'IT Infrastructure Specialist',
  'Influencer',
  'Streamer',
  'Content Creator'
];
const mappedOccupations = occupations.map(occ => ({ '@type': 'Occupation', 'name': occ }));


// ===== JSON-LD SEGÚN SCHEMA =====
let jsonLd = {};
switch (schema) {
  case 'person':
    jsonLd = {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': `${siteUrl}/#person`,
          'name': 'Pablo Sebastian Marchetti Orayen',
          'givenName': 'Pablo Sebastian',
          'familyName': 'Marchetti Orayen',
          'alternateName': [
            'SolarisPKN',
            'Pablo Kouta Nya',
            'Solaris PKN',
            'SolarisPKN_Live',
            'SolarisPKN Streams',
            'PabloKoutaNya',
            'TecnOtakus'
          ],
          'description': description,
          'url': siteUrl,
          'image': {
            '@type': 'ImageObject',
            '@id': `${siteUrl}/#image`,
            'url': fullImage
          },
          'jobTitle': jobTitle,
          'knowsLanguage': ['es-AR', 'es', 'en'],
          'nationality': {
            '@type': 'Country',
            'name': 'Argentina'
          },
          'worksFor': {
            '@id': `${siteUrl}/#organization`
          },
          'founder': {
           '@id': `${siteUrl}/#organization`
          },
          'contactPoint': {
            '@type': 'ContactPoint',
            'contactType': 'Business Contact',
            'email': 'contacto@solarispkn.com.ar'
          },
          'hasCredential': mappedCredentials,
          'hasOccupation': mappedOccupations,
          'sameAs': [
            'https://github.com/SolarisPKN',
