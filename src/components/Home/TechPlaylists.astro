---
const { words } = Astro.props;
const ids = {
  pc:'PLVxh46uVOYfb5YCI8AqG5jK_TB8p0vu9D',
  auto:'PLVxh46uVOYfYbTsYFmaZ31w8AyCOs9yuG'
};
const playlists=words.playlists.filter(p=>p.key in ids).map(p=>({
  ...p,id:ids[p.key],url:'https://www.youtube.com/playlist?list='+ids[p.key]
}));
const scriptConfig=JSON.stringify({playlistInfo:playlists,words:{
 videoIframe:words.videoIframe,
 videoLoading:words.videoLoading,
 videoUnavailable:words.videoUnavailable,
 videoFallback:words.videoFallback,
 videoPartial:words.videoPartial,
 videoCount:words.videoCount
}}).replace(/</g,'\\u003c');
---

<div class="tech-video-shell" data-tech-playlists>
  <div class="tech-video-tabs" role="group" aria-label={words.videoPick}>
    {playlists.map((list,index)=>(
      <button type="button" class:list={['tech-playlist-option',{chosen:index===0}]} data-playlist={list.id} aria-pressed={index===0}>
        <span class="tech-playlist-number">{String(index+1).padStart(2,'0')}</span>
        <span>{list.label}</span>
      </button>
    ))}
  </div>
  <div class="tech-video-layout">
    <div class="tech-video-main">
      <div class="tech-video-display">
        <div data-video-holder>
          <!-- Native iframe fallback: mobile and no-JavaScript users can watch directly. -->
          <iframe
            data-video-fallback-frame
            src={'https://www.youtube-nocookie.com/embed/videoseries?list='+playlists[0].id+'&playsinline=1'}
            title={playlists[0].title}
            loading="lazy"
            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <div class="tech-video-placeholder" data-video-placeholder hidden>
          <span class="tech-video-play-icon" aria-hidden="true">▶</span>
          <p>{words.videoLoading}</p>
        </div>
      </div>
      <div class="tech-video-info">
        <div class="tech-overline">SOLARISPKN / YOUTUBE</div>
        <h3 data-video-title>{playlists[0].title}</h3>
        <p data-video-description>{playlists[0].description}</p>
        <a data-video-link href={playlists[0].url} target="_blank" rel="noopener noreferrer">{words.videoOpen} ↗</a>
      </div>
    </div>
    <aside class="tech-queue" aria-label={words.videoQueueHeading}>
      <div class="tech-queue-header">
        <h3>{words.videoQueueHeading}</h3>
        <span data-video-count aria-live="polite">{words.videoLoading}</span>
      </div>
      <div class="tech-queue-list" data-video-list role="list">
        {playlists.map(list => (
          <a class="tech-queue-fallback" role="listitem" href={list.url} target="_blank" rel="noopener noreferrer">
            <span>{list.title}</span><span>{words.videoOpen} ↗</span>
          </a>
        ))}
      </div>
      <p class="tech-queue-footnote" data-video-warning hidden>{words.videoPartial}</p>
      <a class="tech-queue-more" data-video-more href={playlists[0].url} target="_blank" rel="noopener noreferrer">{words.videoOpen} ↗</a>
    </aside>
  </div>
  <script type="application/json" data-tech-config set:html={scriptConfig}></script>
</div>

<script>import '../../scripts/tech-playlists.js';</script>


<style>
.tech-video-shell{border:1px solid rgba(177,221,236,.18);border-radius:20px;background:rgba(5,12,23,.68);padding:clamp(.75rem,1.9vw,1.35rem)}
.tech-video-tabs{display:flex;gap:.65rem;flex-wrap:wrap;margin-bottom:1rem}
.tech-playlist-option{display:flex;align-items:center;gap:.5rem;border:1px solid #33445e;background:rgba(19,30,47,.94);border-radius:10px;padding:.65rem .95rem;color:#d6e4f4;font-size:.87rem;cursor:pointer;font-family:inherit}
.tech-playlist-option:hover,.tech-playlist-option.chosen{border-color:#00ffcc;background:rgba(0,255,204,.1);color:#fff}
.tech-playlist-number{color:#00ffcc;font:700 .7rem 'JetBrains Mono',monospace}
.tech-video-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(285px,.85fr);gap:1rem;align-items:start}
.tech-video-main{min-width:0;display:flex;flex-direction:column;gap:.8rem}
.tech-video-display{position:relative;min-width:0;background:#050911;border-radius:12px;aspect-ratio:16/9;overflow:hidden;border:1px solid #273a4b}
.tech-video-display :global(iframe),.tech-video-display :global([data-video-holder]){position:absolute;inset:0;width:100%;height:100%;border:0;display:block}
.tech-video-placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;background:#081421;z-index:1;color:#bdd8df}
.tech-video-placeholder[hidden]{display:none}
.tech-video-play-icon{width:52px;height:52px;display:grid;place-items:center;border:1px solid #5ce5d0;color:#5ce5d0;border-radius:50%;font-size:1.3rem}
.tech-video-info{display:flex;flex-direction:column;gap:.45rem;padding:.2rem .4rem}
.tech-video-info .tech-overline{font:700 .7rem 'JetBrains Mono',monospace;color:#63f0d5;letter-spacing:.1em}
.tech-video-info h3{font-size:clamp(1.05rem,1.65vw,1.4rem);line-height:1.25}
.tech-video-info p{font-size:.85rem;color:#b9c9d5;line-height:1.6}
.tech-video-info a,.tech-queue-more{color:#7bffe2;text-decoration:none;font-size:.83rem;font-weight:750}
.tech-queue{min-width:0;display:flex;flex-direction:column;overflow:hidden;background:#0a1422;border:1px solid #304257;border-radius:12px;padding:.7rem}
.tech-queue-header{display:flex;align-items:baseline;flex-wrap:wrap;justify-content:space-between;gap:.4rem;padding:.3rem .45rem .65rem;border-bottom:1px solid #273a4b}
.tech-queue-header h3{font-size:1rem;margin:0}.tech-queue-header span{font-size:.7rem;color:#a4bcca}
.tech-queue-list{display:flex;flex-direction:column;gap:.25rem;max-height:clamp(280px,35vw,510px);overflow-y:auto;overscroll-behavior:contain;padding:.5rem .15rem}
.tech-queue-list :global(.tech-queue-item){width:100%;display:flex;gap:.65rem;align-items:center;text-align:left;background:#112034;border:1px solid transparent;border-radius:9px;padding:.45rem;color:#e6f1f6;cursor:pointer;font:inherit}
.tech-queue-list :global(.tech-queue-item:hover),.tech-queue-list :global(.tech-queue-item.current){background:#173846;border-color:#3cbba8}
.tech-queue-list :global(.tech-queue-item:focus-visible){outline:2px solid #ff79c6}
.tech-queue-list :global(.tech-queue-item img){width:100px;height:56px;object-fit:cover;border-radius:6px;flex:0 0 100px;background:#111b2c}
.tech-queue-list :global(.tech-queue-item-info){min-width:0;display:flex;flex-direction:column;gap:.28rem}
.tech-queue-list :global(.tech-queue-item-title){font-weight:650;font-size:.81rem;line-height:1.3;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tech-queue-list :global(.tech-queue-item-index){font-size:.68rem;color:#8fabbd}
.tech-queue-message{font-size:.85rem;color:#aec6d2;padding:.7rem}
.tech-queue-list :global(.tech-queue-fallback){display:flex;flex-wrap:wrap;justify-content:space-between;gap:.6rem;padding:.75rem;background:#112034;border:1px solid #305268;border-radius:9px;color:#c5fff4;text-decoration:none;font-size:.85rem;min-height:44px}
.tech-queue-list :global(.tech-queue-fallback:focus-visible){outline:2px solid #ff79c6}
.tech-queue-footnote{font-size:.73rem;color:#a9bac7;line-height:1.5;margin:.65rem .35rem}
.tech-queue-more{display:inline-block;margin:.55rem .45rem}
@media(max-width:850px){.tech-video-layout{grid-template-columns:1fr}.tech-queue-list{max-height:330px}}
@media(max-width:450px){.tech-video-display{width:100%;max-width:100%}.tech-playlist-option{flex:1;justify-content:center;padding:.6rem;font-size:.75rem}.tech-playlist-number{display:none}.tech-video-shell{padding:.5rem}.tech-queue-list :global(.tech-queue-item img){width:80px;height:45px;flex-basis:80px}}
@media(prefers-reduced-motion:reduce){.tech-queue-list{scroll-behavior:auto}}
</style>
