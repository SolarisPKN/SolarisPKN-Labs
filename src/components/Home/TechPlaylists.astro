---
const { words } = Astro.props;
const ids = {
  pc:'PLVxh46uVOYfb5YCI8AqG5jK_TB8p0vu9D',
  auto:'PLVxh46uVOYfYbTsYFmaZ31w8AyCOs9yuG'
};
const playlists=words.playlists.filter(p=>p.key in ids).map(p=>({
  ...p,id:ids[p.key],url:'https://www.youtube.com/playlist?list='+ids[p.key]
}));
---

<div class="tech-video-shell" data-tech-playlists>
  <div class="tech-video-tabs" role="group" aria-label={words.videoPick}>
    {playlists.map((list,index)=>(
      <button type="button" class:list={['tech-playlist-option',{chosen:index===0}]} data-playlist={list.id} aria-pressed={index===0}>
        <span class="tech-playlist-number">{String(index+1).padStart(2,'0')}</span>
        <span>{list.label}</span>
      </button>
    ))}
  </div>
  <div class="tech-video-layout">
    <div class="tech-video-main">
      <div class="tech-video-display">
        <div data-video-holder></div>
        <div class="tech-video-placeholder" data-video-placeholder>
          <span class="tech-video-play-icon" aria-hidden="true">▶</span>
          <p>{words.videoLoading}</p>
        </div>
      </div>
      <div class="tech-video-info">
        <div class="tech-overline">SOLARISPKN / YOUTUBE</div>
        <h3 data-video-title>{playlists[0].title}</h3>
        <p data-video-description>{playlists[0].description}</p>
        <a data-video-link href={playlists[0].url} target="_blank" rel="noopener noreferrer">{words.videoOpen} ↗</a>
      </div>
    </div>
    <aside class="tech-queue" aria-label={words.videoQueueHeading}>
      <div class="tech-queue-header">
        <h3>{words.videoQueueHeading}</h3>
        <span data-video-count aria-live="polite">{words.videoLoading}</span>
      </div>
      <div class="tech-queue-list" data-video-list role="list">
        <p class="tech-queue-message">{words.videoLoading}</p>
      </div>
      <p class="tech-queue-footnote" data-video-warning hidden>{words.videoPartial}</p>
      <a class="tech-queue-more" data-video-more href={playlists[0].url} target="_blank" rel="noopener noreferrer">{words.videoOpen} ↗</a>
    </aside>
  </div>
</div>

<script define:vars={{playlistInfo:playlists,words: {
 videoIframe:words.videoIframe,
 videoLoading:words.videoLoading,
 videoUnavailable:words.videoUnavailable,
 videoFallback:words.videoFallback,
 videoPartial:words.videoPartial,
 videoCount:words.videoCount
}}>
// No API key: official public YouTube iframe API supplies live playlist video IDs,
// and our same-origin Worker reads the public Atom feed to annotate recent titles.
function readyYouTubePlayer(){
 return new Promise((resolve,reject)=>{
  if(window.YT && typeof window.YT.Player==='function')return resolve(window.YT);
  const previous=window.onYouTubeIframeAPIReady;
  window.onYouTubeIframeAPIReady=function(){
   if(typeof previous==='function')previous();
   resolve(window.YT);
  };
  if(!document.querySelector('script[data-tech-yt-api]')){
   const script=document.createElement('script');
   script.dataset.techYtApi='1';
   script.async=true;
   script.src='https://www.youtube.com/iframe_api';
   script.onerror=()=>reject(new Error('youtube-api-unavailable'));
   document.head.appendChild(script);
  }
  setTimeout(()=>reject(new Error('youtube-api-timeout')),12000);
 });
}
function initializeTechPlaylists(){
 document.querySelectorAll('[data-tech-playlists]').forEach(root=>{
  if(root.dataset.initialized==='1')return;
  root.dataset.initialized='1';
  const tabs=[...root.querySelectorAll('[data-playlist]')];
  const queue=root.querySelector('[data-video-list]');
  const count=root.querySelector('[data-video-count]');
  const warning=root.querySelector('[data-video-warning]');
  const placeholder=root.querySelector('[data-video-placeholder]');
  const title=root.querySelector('[data-video-title]');
  const description=root.querySelector('[data-video-description]');
  const playlistLink=root.querySelector('[data-video-link]');
  const moreLink=root.querySelector('[data-video-more]');
  const holder=root.querySelector('[data-video-holder]');
  const VIDEO_ID=/^[a-zA-Z0-9_-]{11}$/;
  let selected=0;
  let generation=0;
  let player=null;
  let liveIds=[];
  let recent=[];
  let currentIds=[];
  let pollTimer=null;
  let disposed=false;

  function setCount(n){
   count.textContent=n?words.videoCount+': '+n:words.videoLoading;
  }
  function setActive(index){
   selected=index;
   const info=playlistInfo[index];
   tabs.forEach((tab,i)=>{
    tab.classList.toggle('chosen',i===index);
    tab.setAttribute('aria-pressed',String(i===index));
   });
   title.textContent=info.title;
   description.textContent=info.description;
   playlistLink.href=info.url;
   moreLink.href=info.url;
  }
  function draw(items){
   if(disposed)return;
   const parent=document.createDocumentFragment();
   if(!items.length){
     const p=document.createElement('p');
     p.className='tech-queue-message';
     p.textContent=words.videoUnavailable;
     parent.append(p);
   }
   items.forEach((video,index)=>{
     const button=document.createElement('button');
     button.type='button';
     button.className='tech-queue-item';
     button.setAttribute('role','listitem');
     button.dataset.videoId=video.id;
     const thumb=document.createElement('img');
     thumb.alt='';
     thumb.width=112;thumb.height=63;
     thumb.loading='lazy';
     thumb.src='https://i.ytimg.com/vi/'+video.id+'/mqdefault.jpg';
     const detail=document.createElement('span');
     detail.className='tech-queue-item-info';
     const label=document.createElement('span');
     label.className='tech-queue-item-title';
     label.textContent=video.title||words.videoFallback+' '+(index+1);
     const seq=document.createElement('span');
     seq.className='tech-queue-item-index';
     seq.textContent=String(index+1).padStart(2,'0');
     detail.append(label,seq);
     button.append(thumb,detail);
     button.addEventListener('click',()=>{
      if(player && typeof player.playVideoAt==='function' && liveIds.includes(video.id)){
       player.playVideoAt(liveIds.indexOf(video.id)); // user gesture, playlist order preserved
      }else if(player && typeof player.loadVideoById==='function'){
       player.loadVideoById(video.id); // public recent feed fallback
      }else{
       window.open('https://www.youtube.com/watch?v='+encodeURIComponent(video.id),'_blank','noopener');
      }
      queue.querySelectorAll('.tech-queue-item').forEach(x=>x.classList.toggle('current',x.dataset.videoId===video.id));
     });
     parent.append(button);
   });
   queue.replaceChildren(parent);
   setCount(items.length);
  }
  function drawCombined(){
   const titles=new Map(recent.map(v=>[v.id,v.title]));
   // getPlaylist() returns the currently available IDs in the official embedded player.
   // RSS is a recent-only fallback, never falsely labeled as the entire archive.
   const ids=liveIds.length?liveIds:recent.map(v=>v.id);
   currentIds=ids.map(id=>({id,title:titles.get(id)||''})).filter(x=>VIDEO_ID.test(x.id));
   draw(currentIds);
   warning.hidden=liveIds.length>0;
  }
  function pollList(gen,tries=0){
   if(disposed||gen!==generation||!player)return;
   const ids=typeof player.getPlaylist==='function'?player.getPlaylist():null;
   if(Array.isArray(ids) && ids.some(id=>VIDEO_ID.test(id))){
     const cleaned=[...new Set(ids.filter(id=>VIDEO_ID.test(id)))];
     if(cleaned.join('|')!==liveIds.join('|')){
      liveIds=cleaned;
      drawCombined();
     }
     if(tries>=12)return;
   }
   if(tries<20)pollTimer=setTimeout(()=>pollList(gen,tries+1),350);
   else drawCombined();
  }
  async function loadRecent(gen,index){
   try{
     const response=await fetch('/api/tech-playlist?list='+encodeURIComponent(playlistInfo[index].key),{cache:'no-store'});
     if(!response.ok)throw new Error('public-feed-unavailable');
     const data=await response.json();
     if(gen!==generation||disposed)return;
     recent=Array.isArray(data.videos)?data.videos.filter(x=>VIDEO_ID.test(x.id)): [];
     drawCombined();
   }catch{
     if(gen!==generation||disposed)return;
     if(!liveIds.length)draw([]);
   }
  }
  function select(index){
   if(index<0||index>=playlistInfo.length)return;
   generation++;
   clearTimeout(pollTimer);
   liveIds=[];recent=[];currentIds=[];
   setActive(index);
   queue.textContent=words.videoLoading;
   warning.hidden=true;
   loadRecent(generation,index);
   if(player && typeof player.cuePlaylist==='function'){
     player.cuePlaylist({listType:'playlist',list:playlistInfo[index].id,index:0,startSeconds:0});
     pollList(generation);
   }
  }
  tabs.forEach((button,index)=>button.addEventListener('click',()=>select(index)));
  const track=()=>{
    if(player?.getPlaylistIndex && currentIds.length && liveIds.length){
      const active=liveIds[player.getPlaylistIndex()];
      queue.querySelectorAll('.tech-queue-item').forEach(x=>x.classList.toggle('current',x.dataset.videoId===active));
    }
    pollList(generation);
  };
  readyYouTubePlayer().then(YT=>{
    if(disposed||!holder.isConnected)return;
    player=new YT.Player(holder,{
      width:'100%',height:'100%',
      playerVars:{listType:'playlist',list:playlistInfo[selected].id,playsinline:1,rel:0,origin:location.origin},
      events:{
       onReady:()=>{
         if(disposed)return;
         placeholder.hidden=true;
         player.cuePlaylist({listType:'playlist',list:playlistInfo[selected].id,index:0,startSeconds:0});
         pollList(generation);
       },
       onStateChange:()=>track()
      }
    });
  }).catch(()=>{
    if(disposed)return;
    placeholder.querySelector('p').textContent=words.videoUnavailable;
  });
  select(0);
  const cleanup=()=>{disposed=true;clearTimeout(pollTimer);if(player?.destroy)player.destroy();document.removeEventListener('astro:before-swap',cleanup);};
  document.addEventListener('astro:before-swap',cleanup,{once:true});
 });
}
document.addEventListener('astro:page-load',initializeTechPlaylists);
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initializeTechPlaylists,{once:true});
else initializeTechPlaylists();
</script>

<style>
.tech-video-shell{border:1px solid rgba(177,221,236,.18);border-radius:20px;background:rgba(5,12,23,.68);padding:clamp(.75rem,1.9vw,1.35rem)}
.tech-video-tabs{display:flex;gap:.65rem;flex-wrap:wrap;margin-bottom:1rem}
.tech-playlist-option{display:flex;align-items:center;gap:.5rem;border:1px solid #33445e;background:rgba(19,30,47,.94);border-radius:10px;padding:.65rem .95rem;color:#d6e4f4;font-size:.87rem;cursor:pointer;font-family:inherit}
.tech-playlist-option:hover,.tech-playlist-option.chosen{border-color:#00ffcc;background:rgba(0,255,204,.1);color:#fff}
.tech-playlist-number{color:#00ffcc;font:700 .7rem 'JetBrains Mono',monospace}
.tech-video-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(285px,.85fr);gap:1rem;align-items:start}
.tech-video-main{min-width:0;display:flex;flex-direction:column;gap:.8rem}
.tech-video-display{position:relative;min-width:0;background:#050911;border-radius:12px;aspect-ratio:16/9;overflow:hidden;border:1px solid #273a4b}
.tech-video-display :global(iframe),.tech-video-display :global([data-video-holder]){position:absolute;inset:0;width:100%;height:100%;border:0;display:block}
.tech-video-placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;background:#081421;z-index:1;color:#bdd8df}
.tech-video-placeholder[hidden]{display:none}
.tech-video-play-icon{width:52px;height:52px;display:grid;place-items:center;border:1px solid #5ce5d0;color:#5ce5d0;border-radius:50%;font-size:1.3rem}
.tech-video-info{display:flex;flex-direction:column;gap:.45rem;padding:.2rem .4rem}
.tech-video-info .tech-overline{font:700 .7rem 'JetBrains Mono',monospace;color:#63f0d5;letter-spacing:.1em}
.tech-video-info h3{font-size:clamp(1.05rem,1.65vw,1.4rem);line-height:1.25}
.tech-video-info p{font-size:.85rem;color:#b9c9d5;line-height:1.6}
.tech-video-info a,.tech-queue-more{color:#7bffe2;text-decoration:none;font-size:.83rem;font-weight:750}
.tech-queue{min-width:0;display:flex;flex-direction:column;overflow:hidden;background:#0a1422;border:1px solid #304257;border-radius:12px;padding:.7rem}
.tech-queue-header{display:flex;align-items:baseline;flex-wrap:wrap;justify-content:space-between;gap:.4rem;padding:.3rem .45rem .65rem;border-bottom:1px solid #273a4b}
.tech-queue-header h3{font-size:1rem;margin:0}.tech-queue-header span{font-size:.7rem;color:#a4bcca}
.tech-queue-list{display:flex;flex-direction:column;gap:.25rem;max-height:clamp(280px,35vw,510px);overflow-y:auto;overscroll-behavior:contain;padding:.5rem .15rem}
.tech-queue-list :global(.tech-queue-item){width:100%;display:flex;gap:.65rem;align-items:center;text-align:left;background:#112034;border:1px solid transparent;border-radius:9px;padding:.45rem;color:#e6f1f6;cursor:pointer;font:inherit}
.tech-queue-list :global(.tech-queue-item:hover),.tech-queue-list :global(.tech-queue-item.current){background:#173846;border-color:#3cbba8}
.tech-queue-list :global(.tech-queue-item:focus-visible){outline:2px solid #ff79c6}
.tech-queue-list :global(.tech-queue-item img){width:100px;height:56px;object-fit:cover;border-radius:6px;flex:0 0 100px;background:#111b2c}
.tech-queue-list :global(.tech-queue-item-info){min-width:0;display:flex;flex-direction:column;gap:.28rem}
.tech-queue-list :global(.tech-queue-item-title){font-weight:650;font-size:.81rem;line-height:1.3;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tech-queue-list :global(.tech-queue-item-index){font-size:.68rem;color:#8fabbd}
.tech-queue-message{font-size:.85rem;color:#aec6d2;padding:.7rem}
.tech-queue-footnote{font-size:.73rem;color:#a9bac7;line-height:1.5;margin:.65rem .35rem}
.tech-queue-more{display:inline-block;margin:.55rem .45rem}
@media(max-width:850px){.tech-video-layout{grid-template-columns:1fr}.tech-queue-list{max-height:330px}}
@media(max-width:450px){.tech-playlist-option{flex:1;justify-content:center;padding:.6rem;font-size:.75rem}.tech-playlist-number{display:none}.tech-video-shell{padding:.5rem}.tech-queue-list :global(.tech-queue-item img){width:80px;height:45px;flex-basis:80px}}
@media(prefers-reduced-motion:reduce){.tech-queue-list{scroll-behavior:auto}}
</style>
