---
import { Image } from 'astro:assets';
import gatewayArtwork from '../../assets/index/index.webp';

interface WorldCopy {
  pageTitle: string;
  eyebrow: string;
  heading: string;
  lead: string;
  select: string;
  note: string;
  tech: { title: string; kicker: string; description: string; action: string; status: string };
  gaming: { title: string; kicker: string; description: string; action: string; status: string };
}

const { words, lang = 'es' } = Astro.props as { words: WorldCopy; lang: 'es' | 'en' };

// Artwork composition is fixed: Gaming + Solaris on the LEFT; Tech + Pablo on the RIGHT.
const worlds = [
  { id: 'gaming', href: `/${lang}/under-construction/`, copy: words.gaming, symbol: '✦' },
  { id: 'tech', href: `/${lang}/tech/`, copy: words.tech, symbol: '⌘' }
] as const;
---

<section class="world-gateway" aria-labelledby="worlds-heading">
  <header class="world-gateway-intro">
    <span class="world-overline">{words.eyebrow}</span>
    <h1 id="worlds-heading">{words.heading}</h1>
    <p>{words.lead}</p>
  </header>

  <div class="world-scene" aria-label={words.select}>
    <Image
      src={gatewayArtwork}
      class="world-artwork"
      alt=""
      widths={[480, 720, 960, 1280, 1536]}
      sizes="(max-width: 760px) calc(100vw - 32px), min(1440px, 96vw)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="world-areas">
      {worlds.map((world) => (
        <a
          class:list={['world-hotspot', 'world-hit-'+world.id]}
          href={world.href}
          aria-label={world.copy.title + ' — ' + world.copy.description}
          aria-describedby={'world-card-'+world.id}
          title={world.copy.action}
        ></a>
      ))}
    </div>
  </div>

  <!-- Navigation stays BELOW the artwork, never over faces, icons or the central SolarisPKN logo. -->
  <nav class="world-choice-grid" aria-label={words.select}>
    {worlds.map((world) => (
      <a id={'world-card-'+world.id} class:list={['world-choice', 'world-'+world.id]} href={world.href}>
        <span class="world-topline">
          <span class="world-category">{world.copy.kicker}</span>
          <span class="world-state">{world.copy.status}</span>
        </span>
        <span class="world-title-row">
          <span class="world-icon" aria-hidden="true">{world.symbol}</span>
          <strong class="world-title">{world.copy.title}</strong>
          <span class="world-arrow" aria-hidden="true">↗</span>
        </span>
        <span class="world-description">{world.copy.description}</span>
        <span class="world-action">{world.copy.action} <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </nav>

  <p class="world-footer">{words.note}</p>
</section>

<style>
.world-gateway{--tech:#73ecdf;--gaming:#da9aff;max-width:1510px;padding:clamp(.7rem,2vw,2rem);margin:0 auto 2rem;color:#f7f8ff}
.world-gateway-intro{text-align:center;margin:clamp(.5rem,2vw,1.5rem) auto 1.5rem;max-width:820px}
.world-overline{font:700 .72rem 'JetBrains Mono',monospace;letter-spacing:.17em;color:#8debdc}
.world-gateway-intro h1{font-size:clamp(1.9rem,4vw,3.2rem);line-height:1.12;text-wrap:balance;letter-spacing:-.035em;margin:.65rem 0}
.world-gateway-intro p{font-size:clamp(.92rem,1.3vw,1.05rem);color:#c7d7e3;line-height:1.65}
.world-scene{position:relative;isolation:isolate;width:100%;aspect-ratio:3/2;overflow:hidden;border:1px solid rgba(220,230,255,.26);border-radius:20px;background:#050615;box-shadow:0 15px 55px rgba(0,0,0,.32)}
.world-artwork{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;z-index:-1}
.world-areas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));position:absolute;inset:0}
.world-hotspot{display:block;position:relative;outline-offset:-6px;transition:background .2s ease}
.world-hotspot:hover{background:rgba(255,255,255,.045)}
.world-hotspot:focus-visible{outline:3px solid white;background:rgba(255,255,255,.09)}
.world-hit-gaming:hover{box-shadow:inset 0 0 70px rgba(185,106,255,.15)}
.world-hit-tech:hover{box-shadow:inset 0 0 70px rgba(30,223,211,.15)}
.world-choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(.7rem,1.4vw,1.2rem);margin-top:clamp(.7rem,1.4vw,1.2rem)}
.world-choice{display:flex;flex-direction:column;align-items:flex-start;gap:.68rem;min-width:0;min-height:206px;padding:clamp(1.1rem,2vw,1.7rem);border:1px solid rgba(216,235,250,.2);border-radius:17px;background:linear-gradient(115deg,rgba(23,17,40,.96),rgba(14,19,35,.98));text-decoration:none;color:#f8faff;transition:border-color .2s,background .2s,transform .2s}
.world-tech{background:linear-gradient(115deg,rgba(11,31,40,.96),rgba(14,19,35,.98))}
.world-gaming:hover{border-color:var(--gaming)}.world-tech:hover{border-color:var(--tech)}
.world-choice:hover{transform:translateY(-2px)}
.world-choice:focus-visible{outline:3px solid white;outline-offset:3px}
.world-topline{display:flex;justify-content:space-between;align-items:center;gap:.75rem;width:100%}
.world-category{font:700 clamp(.66rem,.85vw,.77rem) 'JetBrains Mono',monospace;letter-spacing:.05em;line-height:1.4}
.world-gaming .world-category,.world-gaming .world-action,.world-gaming .world-icon{color:var(--gaming)}
.world-tech .world-category,.world-tech .world-action,.world-tech .world-icon{color:var(--tech)}
.world-state{font:650 .7rem 'JetBrains Mono',monospace;letter-spacing:.02em;padding:.25rem .6rem;border:1px solid rgba(222,234,246,.3);border-radius:999px;background:rgba(0,0,0,.21);color:#d6e7ef;white-space:nowrap}
.world-title-row{display:flex;align-items:center;gap:.8rem;width:100%}
.world-icon{font-size:1.45rem;line-height:1}
.world-title{font:800 clamp(1.65rem,3vw,2.8rem) 'Inter',sans-serif;letter-spacing:-.04em;line-height:1.06}
.world-arrow{margin-left:auto;color:#bbd1e1;font-size:1.3rem}
.world-description{font-size:clamp(.83rem,1vw,.93rem);line-height:1.6;color:#c8d8e2;max-width:59ch}
.world-action{font-size:.85rem;font-weight:800;margin-top:auto;padding-top:.3rem;display:inline-flex;gap:.65rem}
.world-footer{text-align:center;color:#9cb3c2;font-size:.83rem;margin:1.1rem auto .2rem}
@media(max-width:760px){
  .world-gateway{padding:clamp(.65rem,2vw,.95rem)}
  .world-scene{border-radius:14px}
  .world-choice-grid{grid-template-columns:1fr}
  .world-choice{min-height:0;padding:1rem 1.1rem;gap:.53rem}
  .world-title{font-size:1.8rem}
  .world-gateway-intro h1{font-size:clamp(1.85rem,6vw,2.45rem)}
}
@media(max-width:420px){
  .world-topline{align-items:flex-start;flex-wrap:wrap}
  .world-category{font-size:.67rem}
  .world-title{font-size:1.65rem}
  .world-description{font-size:.85rem}
}
@media(prefers-reduced-motion:reduce){.world-choice,.world-hotspot{transition:none}.world-choice:hover{transform:none}}
</style>
