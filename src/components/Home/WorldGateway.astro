---
import { Image } from 'astro:assets';
import gatewayArtwork from '../../assets/index/index.webp';

interface WorldCopy {
  pageTitle: string;
  eyebrow: string;
  heading: string;
  lead: string;
  select: string;
  note: string;
  tech: { title: string; kicker: string; description: string; action: string; status: string };
  gaming: { title: string; kicker: string; description: string; action: string; status: string };
}

const { words, lang = 'es' } = Astro.props as { words: WorldCopy; lang: 'es' | 'en' };
const worlds = [
  { id: 'tech', href: `/${lang}/tech/`, copy: words.tech, icon: '⌘', accent: 'cyan' },
  { id: 'gaming', href: `/${lang}/under-construction/`, copy: words.gaming, icon: '✦', accent: 'pink' }
] as const;
---

<section class="world-gateway" aria-labelledby="worlds-heading">
  <header class="world-gateway-intro">
    <span class="world-overline">{words.eyebrow}</span>
    <h1 id="worlds-heading">{words.heading}</h1>
    <p>{words.lead}</p>
  </header>

  <div class="world-scene" aria-label={words.select}>
    <Image
      src={gatewayArtwork}
      class="world-artwork"
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="(max-width: 760px) 100vw, min(1500px, 96vw)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="world-image-dim" aria-hidden="true"></div>
    <div class="world-choice-grid">
      {worlds.map((world) => (
        <a
          class:list={['world-choice', 'world-'+world.id]}
          href={world.href}
          aria-label={world.copy.title+' — '+world.copy.description}
        >
          <span class="world-copy">
            <span class="world-topline">
              <span class="world-icon" aria-hidden="true">{world.icon}</span>
              <span class="world-state">{world.copy.status}</span>
            </span>
            <span class="world-category">{world.copy.kicker}</span>
            <strong class="world-title">{world.copy.title}</strong>
            <span class="world-description">{world.copy.description}</span>
            <span class="world-action">{world.copy.action} <span aria-hidden="true">↗</span></span>
          </span>
        </a>
      ))}
    </div>
    <svg class="world-seam" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M50,0 L48.4,19 L51.4,41 L48.8,61 L51.2,79 L50,100" />
    </svg>
    <span class="world-midmark" aria-hidden="true">S / PKN</span>
  </div>

  <p class="world-footer">{words.note}</p>
</section>

<style>
.world-gateway{--tech:#00ffcc;--game:#ff79c6;max-width:1500px;padding:clamp(1rem,2.6vw,2.6rem);margin:0 auto 2rem;color:#f6f7ff}
.world-gateway-intro{text-align:center;margin:clamp(.5rem,2vw,1.5rem) auto 1.5rem;max-width:820px}
.world-overline{font:700 .72rem 'JetBrains Mono',monospace;letter-spacing:.19em;color:#66e7d3}
.world-gateway-intro h1{font-size:clamp(2rem,5vw,3.8rem);line-height:1.12;text-wrap:balance;letter-spacing:-.04em;margin:.7rem 0 .8rem}
.world-gateway-intro p{font-size:clamp(.95rem,1.5vw,1.1rem);color:#c5d4e1;line-height:1.65}
.world-scene{position:relative;isolation:isolate;min-height:clamp(450px,50vw,640px);overflow:hidden;border-radius:25px;border:1px solid rgba(217,243,255,.23);background:linear-gradient(120deg,#091723 15%,#241021 90%);box-shadow:0 18px 80px rgba(0,0,0,.42)}
.world-artwork{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-2}
.world-image-dim{position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(90deg,rgba(3,18,24,.58),rgba(0,0,0,.14) 46%,rgba(10,8,20,.14) 52%,rgba(20,4,23,.63)),linear-gradient(0deg,rgba(0,0,0,.55),transparent 67%)}
.world-choice-grid{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));min-height:inherit}
.world-choice{display:flex;min-width:0;min-height:inherit;padding:clamp(1.3rem,3.1vw,3.5rem);color:#fff;text-decoration:none;position:relative;align-items:end;isolation:isolate;transition:filter .3s ease,background .3s ease}
.world-choice::before{content:'';position:absolute;inset:0;z-index:-1;opacity:0;transition:opacity .28s ease}
.world-tech::before{background:radial-gradient(circle at 30% 82%,rgba(0,255,204,.22),transparent 65%)}
.world-gaming::before{background:radial-gradient(circle at 75% 80%,rgba(255,121,198,.3),transparent 65%)}
.world-choice:hover::before,.world-choice:focus-visible::before{opacity:1}
.world-choice:focus-visible{outline:3px solid #fff;outline-offset:-5px}
.world-tech{border-right:1px solid rgba(211,243,255,.14)}
.world-gaming{justify-content:flex-end;text-align:right}
.world-copy{display:flex;flex-direction:column;gap:.62rem;max-width:455px;filter:drop-shadow(0 3px 6px #000)}
.world-topline{display:flex;gap:.7rem;align-items:center}
.world-gaming .world-topline{justify-content:flex-end}
.world-icon{display:inline-grid;place-items:center;width:37px;height:37px;border-radius:10px;background:rgba(3,17,27,.74);border:1px solid rgba(255,255,255,.3);font:700 1.4rem monospace}
.world-state{font:650 .7rem 'JetBrains Mono',monospace;letter-spacing:.06em;padding:.27rem .55rem;border:1px solid currentColor;border-radius:100px;background:rgba(0,0,0,.58)}
.world-tech .world-state,.world-tech .world-action,.world-tech .world-category{color:#88ffe5}
.world-gaming .world-state,.world-gaming .world-action,.world-gaming .world-category{color:#ffabd7}
.world-category{font:650 clamp(.65rem,1.15vw,.8rem) 'JetBrains Mono',monospace;letter-spacing:.08em}
.world-title{display:block;font:800 clamp(3.1rem,7.4vw,7.2rem) 'Inter',sans-serif;letter-spacing:-.065em;line-height:.98;text-shadow:0 5px 28px #000}
.world-description{max-width:39ch;font-size:clamp(.87rem,1.25vw,1.02rem);line-height:1.55;color:#eef6fc}
.world-action{display:inline-flex;align-items:center;gap:1rem;width:max-content;margin-top:.6rem;background:rgba(6,11,19,.83);border:1px solid currentColor;border-radius:12px;padding:.7rem 1rem;font-weight:750;transition:transform .2s ease}
.world-gaming .world-action{align-self:end}
.world-choice:hover .world-action{transform:translateY(-3px)}
.world-seam{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2}
.world-seam path{fill:none;stroke:rgba(255,255,255,.76);stroke-width:.23;filter:drop-shadow(0 0 2px rgba(0,255,204,.7))}
.world-midmark{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:99px;border:1px solid rgba(255,255,255,.55);background:rgba(11,12,19,.86);font:700 .65rem 'JetBrains Mono',monospace;padding:.65rem;letter-spacing:.02em;z-index:3;pointer-events:none;white-space:nowrap}
.world-footer{text-align:center;color:#9db7c6;font-size:.86rem;margin:1.25rem auto .25rem}
@media(max-width:760px){
 .world-gateway{padding:.9rem}
 .world-scene{min-height:650px;border-radius:17px}
 .world-choice-grid{grid-template-columns:1fr;grid-template-rows:repeat(2,minmax(320px,1fr));min-height:650px}
 .world-choice{min-height:320px;padding:1.65rem;align-items:end}
 .world-gaming{border-top:1px solid rgba(255,255,255,.3)}
 .world-artwork{object-position:center}
 .world-image-dim{background:linear-gradient(180deg,rgba(5,20,28,.35),rgba(0,0,0,.54) 49%,rgba(15,3,19,.45) 55%,rgba(0,0,0,.66))}
 .world-seam{display:none}
 .world-midmark{top:50%}
 .world-gaming .world-copy{margin-left:auto}
 .world-title{font-size:clamp(3.3rem,12vw,5.8rem)}
 .world-description{font-size:.91rem}
}
@media(max-width:420px){
 .world-copy{gap:.43rem}
 .world-title{font-size:clamp(2.8rem,13vw,4.5rem)}
 .world-category{font-size:.67rem}
 .world-gateway-intro h1{font-size:1.9rem}
}
@media(prefers-reduced-motion:reduce){.world-choice,.world-choice::before,.world-action{transition:none}.world-choice:hover .world-action{transform:none}}
</style>
