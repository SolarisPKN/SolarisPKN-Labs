---
import { Image } from 'astro:assets';
import gatewayArtwork from '../../assets/index/index.webp';

interface WorldCopy {
  pageTitle: string;
  eyebrow: string;
  heading: string;
  lead: string;
  select: string;
  note: string;
  tech: { title: string; kicker: string; description: string; action: string; status: string };
  gaming: { title: string; kicker: string; description: string; action: string; status: string };
}

const { words, lang = 'es' } = Astro.props as { words: WorldCopy; lang: 'es' | 'en' };

// The existing original image places Gaming/Solaris at left and Tech/Pablo at right.
// Each half is ONE link: no separate cards, nested buttons or duplicate hotspots.
const worlds = [
  { id: 'gaming', href: `/${lang}/gaming/`, copy: words.gaming, symbol: '✦' },
  { id: 'tech', href: `/${lang}/tech/`, copy: words.tech, symbol: '⌘' }
] as const;

// Reusable CSS-driven particles: generated once, only animated on hover/focus.
// Their positions are mirrored on the right. No canvas, JS listeners or intervals.
const particles = [
  { x: 7, y: 15, size: 2, delay: -.4, duration: 3.2 },
  { x: 17, y: 29, size: 3, delay: -1.7, duration: 4.1 },
  { x: 29, y: 18, size: 2, delay: -2.4, duration: 3.8 },
  { x: 40, y: 39, size: 3, delay: -.9, duration: 4.4 },
  { x: 10, y: 55, size: 3, delay: -1.1, duration: 3.4 },
  { x: 23, y: 62, size: 2, delay: -3.0, duration: 4.6 },
  { x: 34, y: 75, size: 3, delay: -2.1, duration: 3.7 },
  { x: 13, y: 84, size: 2, delay: -.5, duration: 4.9 },
  { x: 42, y: 88, size: 2, delay: -2.5, duration: 3.1 },
  { x: 38, y: 12, size: 2, delay: -1.9, duration: 4.0 },
  { x: 25, y: 46, size: 3, delay: -2.9, duration: 4.3 },
  { x: 6, y: 70, size: 2, delay: -1.5, duration: 3.6 }
];
---

<section class="world-gateway" aria-labelledby="worlds-heading">
  <header class="world-gateway-intro">
    <span class="world-overline">{words.eyebrow}</span>
    <h1 id="worlds-heading">{words.heading}</h1>
    <p>{words.lead}</p>
  </header>

  <div class="world-split" role="group" aria-label={words.select}>
    <Image
      src={gatewayArtwork}
      class="world-artwork"
      alt=""
      widths={[480, 720, 960, 1280, 1536]}
      sizes="(max-width: 760px) calc(100vw - 24px), min(1470px, 96vw)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    {worlds.map((world) => (
      <a
        class:list={['world-half', 'world-'+world.id]}
        href={world.href}
        aria-label={world.copy.title + ' — ' + world.copy.description}
      >
        <span class="world-hover-glow" aria-hidden="true"></span>
        <span class="world-particles" aria-hidden="true">
          {particles.map((particle) => (
            <span
              class="world-particle"
              style={'--x:'+particle.x+'%;--y:'+particle.y+'%;--sz:'+particle.size+'px;--delay:'+particle.delay+'s;--duration:'+particle.duration+'s'}
            ></span>
          ))}
        </span>

        <span class="world-copy">
          <span class="world-metadata">
            <span class="world-kicker">{world.copy.kicker}</span>
            <span class="world-status">{world.copy.status}</span>
          </span>
          <span class="world-name">
            <span class="world-symbol" aria-hidden="true">{world.symbol}</span>
            <strong>{world.copy.title}</strong>
            <span class="world-arrow" aria-hidden="true">↗</span>
          </span>
          <span class="world-description">{world.copy.description}</span>
          <span class="world-action">{world.copy.action} <span aria-hidden="true">→</span></span>
        </span>
      </a>
    ))}

    <!-- Path precisely follows the complementary clip-path polygon used for both halves. -->
    <svg class="world-crack" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="world-crack-glow" d="M50 0 L48 12 L52 23 L49 33 L52 43 L49 50 L53 62 L48 74 L51 83 L49 94 L50 100"></path>
      <path class="world-crack-line" d="M50 0 L48 12 L52 23 L49 33 L52 43 L49 50 L53 62 L48 74 L51 83 L49 94 L50 100"></path>
    </svg>
  </div>

  <p class="world-footer">{words.note}</p>
</section>

<style>
.world-gateway{--gaming:#d5a0ff;--tech:#78fff0;max-width:1510px;margin:0 auto 2rem;padding:clamp(.65rem,1.7vw,1.5rem);color:#f7f8ff}
.world-gateway-intro{text-align:center;margin:clamp(.45rem,1.8vw,1.35rem) auto 1.3rem;max-width:830px}
.world-overline{font:700 .72rem 'JetBrains Mono',monospace;letter-spacing:.16em;color:#81efdc}
.world-gateway-intro h1{font-size:clamp(1.9rem,4vw,3.3rem);line-height:1.12;letter-spacing:-.035em;text-wrap:balance;margin:.65rem 0 .75rem}
.world-gateway-intro p{font-size:clamp(.92rem,1.3vw,1.07rem);color:#c0d4df;line-height:1.65;margin:0}
.world-split{position:relative;isolation:isolate;aspect-ratio:3/2;width:100%;overflow:hidden;border-radius:21px;border:1px solid rgba(212,223,255,.3);background:#070918;box-shadow:0 16px 55px rgba(0,0,0,.36)}
.world-artwork{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;object-position:center;z-index:0;pointer-events:none}
.world-half{position:absolute;inset:0;display:flex;align-items:flex-end;min-width:0;padding:clamp(.6rem,1.7vw,1.6rem);color:#f9fdff;text-decoration:none;z-index:1;cursor:pointer;isolation:isolate}
.world-gaming{clip-path:polygon(0 0,50% 0,48% 12%,52% 23%,49% 33%,52% 43%,49% 50%,53% 62%,48% 74%,51% 83%,49% 94%,50% 100%,0 100%)}
.world-tech{clip-path:polygon(50% 0,100% 0,100% 100%,50% 100%,49% 94%,51% 83%,48% 74%,53% 62%,49% 50%,52% 43%,49% 33%,52% 23%,48% 12%);justify-content:flex-end}
.world-half:focus-visible{outline:4px solid white;outline-offset:-6px}
.world-hover-glow{position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:0;transition:opacity .3s ease}
.world-gaming .world-hover-glow{background:radial-gradient(ellipse at 16% 75%,rgba(159,73,244,.32),transparent 48%)}
.world-tech .world-hover-glow{background:radial-gradient(ellipse at 84% 75%,rgba(30,224,207,.29),transparent 48%)}
.world-half:is(:hover,:focus-visible) .world-hover-glow{opacity:1}
.world-copy{display:flex;position:relative;flex-direction:column;gap:.48rem;width:min(40%,425px);padding:clamp(.8rem,1.35vw,1.2rem);background:rgba(6,9,21,.48);border:1px solid rgba(233,239,255,.2);border-radius:13px;backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);box-shadow:0 5px 24px rgba(0,0,0,.25);transition:background .28s ease,border-color .28s ease,transform .28s ease}
.world-half:is(:hover,:focus-visible) .world-copy{background:rgba(6,9,21,.76);border-color:rgba(239,248,255,.5);transform:translateY(-4px)}
.world-tech .world-copy{text-align:right;align-items:flex-end}
.world-metadata{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;justify-content:space-between;width:100%}
.world-tech .world-metadata{flex-direction:row-reverse}
.world-kicker{font:700 clamp(.58rem,.73vw,.73rem) 'JetBrains Mono',monospace;letter-spacing:.045em;line-height:1.4}
.world-status{font:600 .66rem 'JetBrains Mono',monospace;white-space:nowrap;border:1px solid rgba(255,255,255,.27);background:rgba(0,0,0,.24);border-radius:999px;padding:.23rem .5rem;color:#e7eff9}
.world-name{display:flex;align-items:center;gap:.7rem;width:100%}
.world-name strong{font:800 clamp(1.55rem,2.7vw,2.55rem) 'Inter',sans-serif;letter-spacing:-.04em;line-height:1.03}
.world-symbol{font-size:1.25rem}
.world-arrow{font-size:1.1rem;color:#fff;margin-left:auto}
.world-tech .world-name{justify-content:flex-end}
.world-tech .world-arrow{margin-left:0}
.world-gaming .world-symbol,.world-gaming .world-action,.world-gaming .world-kicker{color:var(--gaming)}
.world-tech .world-symbol,.world-tech .world-action,.world-tech .world-kicker{color:var(--tech)}
.world-description{font-size:clamp(.75rem,.9vw,.9rem);line-height:1.48;color:#e2eaf3}
.world-action{font-weight:800;font-size:clamp(.73rem,.86vw,.85rem);display:inline-flex;align-items:center;gap:.5rem}
.world-particles{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden;opacity:0;transition:opacity .28s ease}
.world-half:is(:hover,:focus-visible) .world-particles{opacity:1}
.world-particle{position:absolute;left:var(--x);top:var(--y);width:var(--sz);height:var(--sz);border-radius:50%;background:var(--gaming);box-shadow:0 0 7px 2px rgba(196,128,255,.68);animation:world-drift var(--duration) ease-in-out var(--delay) infinite alternate}
.world-tech .world-particle{left:calc(100% - var(--x));background:var(--tech);box-shadow:0 0 7px 2px rgba(63,244,220,.62)}
@keyframes world-drift{0%{transform:translate3d(0,7px,0) scale(.8);opacity:.15}45%{opacity:1}100%{transform:translate3d(4px,-15px,0) scale(1.25);opacity:.25}}
.world-crack{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3;overflow:visible}
.world-crack path{fill:none;stroke-linejoin:round;stroke-linecap:round}
.world-crack-glow{stroke:rgba(153,105,255,.44);stroke-width:1.1;filter:drop-shadow(0 0 2px rgba(125,243,255,.8))}
.world-crack-line{stroke:rgba(234,246,255,.79);stroke-width:.22;filter:drop-shadow(0 0 2px rgba(174,117,255,.85))}
.world-split:has(.world-half:hover) .world-crack-line,.world-split:has(.world-half:focus-visible) .world-crack-line{stroke:rgba(255,255,255,.95)}
.world-footer{text-align:center;color:#9cb6c6;font-size:.84rem;margin:1.05rem auto .2rem}
@media(max-width:1100px){
 .world-copy{width:min(42%,425px);gap:.35rem;padding:.8rem}
 .world-description{font-size:.78rem}
 .world-metadata{gap:.25rem}
 .world-status{font-size:.58rem}
}
@media(max-width:760px){
 .world-gateway{padding:clamp(.45rem,1.8vw,.85rem)}
 .world-split{border-radius:14px}
 .world-half{padding:clamp(.3rem,1vw,.7rem)}
 .world-copy{width:44%;padding:clamp(.3rem,1vw,.65rem);border-radius:8px;gap:.25rem;backdrop-filter:none;-webkit-backdrop-filter:none;background:rgba(3,8,18,.68)}
 .world-kicker,.world-status,.world-description,.world-symbol{display:none}
 .world-name strong{font-size:clamp(.79rem,2.65vw,1.4rem);letter-spacing:-.03em}
 .world-name{gap:.15rem}
 .world-arrow{font-size:.8rem}
 .world-action{font-size:clamp(.5rem,1.6vw,.78rem);gap:.2rem}
 .world-crack-glow{stroke-width:.8}
 .world-gateway-intro h1{font-size:clamp(1.85rem,6vw,2.4rem)}
}
@media(max-width:380px){
 .world-copy{width:46%;padding:.3rem}
 .world-name strong{font-size:.8rem}
 .world-action{font-size:.55rem}
}
@media(hover:none){
 .world-half:is(:active,:focus-visible) .world-hover-glow{opacity:1}
}
@media(prefers-reduced-motion:reduce){
 .world-hover-glow,.world-copy,.world-particles{transition:none}
 .world-particle{animation:none;opacity:.75}
 .world-half:is(:hover,:focus-visible) .world-copy{transform:none}
}
</style>
